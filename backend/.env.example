# Application
NODE_ENV=development
APP_NAME=HRMS Enterprise API
APP_PORT=3000
APP_URL=http://localhost:3000
API_PREFIX=/api/v1

# Database
DATABASE_URL=mysql://root:password@localhost:3306/hris_enterprise

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=your-access-secret-key-min-32-chars-long
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=hrms-enterprise

# Password
BCRYPT_SALT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Rate Limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Mail
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@hrms.com
SMTP_FROM_NAME=HRMS Enterprise

# Upload
UPLOAD_MAX_FILE_SIZE=5242880
UPLOAD_ALLOWED_MIMES=image/jpeg,image/png,image/gif,application/pdf
UPLOAD_PATH=uploads

# Logging
LOG_LEVEL=debug
LOG_DIR=logs

# Session
SESSION_SECRET=your-session-secret-key-min-32-chars

# CSRF
CSRF_SECRET=your-csrf-secret-key-min-32-chars

# Encryption
ENCRYPTION_KEY=your-32-char-encryption-key-here-1234
