/// Leave type master data
model LeaveType {
  id          String   @id @default(uuid()) @db.VarChar(36)
  companyId   String   @map("company_id") @db.VarChar(36)
  name        String   @db.VarChar(255)
  code        String   @unique @db.VarChar(50)
  description String?  @db.Text
  isPaid      Boolean  @default(true) @map("is_paid")
  isAnnual    Boolean  @default(false) @map("is_annual")
  maxDays     Int      @default(0) @map("max_days")
  requiresAttachment Boolean @default(false) @map("requires_attachment")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  requests LeaveRequest[]
  balances LeaveBalance[]

  @@index([companyId])
  @@index([code])
  @@map("leave_types")
}

/// Employee leave balance per year
model LeaveBalance {
  id          String   @id @default(uuid()) @db.VarChar(36)
  employeeId  String   @map("employee_id") @db.VarChar(36)
  companyId   String   @map("company_id") @db.VarChar(36)
  leaveTypeId String   @map("leave_type_id") @db.VarChar(36)
  year        Int      @default(2026)
  totalDays   Int      @default(0) @map("total_days")
  usedDays    Int      @default(0) @map("used_days")
  remainingDays Int    @default(0) @map("remaining_days")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId])
  @@index([companyId])
  @@map("leave_balances")
}

/// Leave request with approval flow
model LeaveRequest {
  id              String        @id @default(uuid()) @db.VarChar(36)
  employeeId      String        @map("employee_id") @db.VarChar(36)
  companyId       String        @map("company_id") @db.VarChar(36)
  leaveTypeId     String        @map("leave_type_id") @db.VarChar(36)
  startDate       DateTime      @map("start_date") @db.Date
  endDate         DateTime      @map("end_date") @db.Date
  totalDays       Int           @default(1) @map("total_days")
  reason          String        @db.Text
  attachment      String?       @db.VarChar(500)
  status          LeaveStatus   @default(PENDING)
  approvedBy      String?       @map("approved_by") @db.VarChar(36)
  approvedAt      DateTime?     @map("approved_at")
  rejectionReason String?       @map("rejection_reason") @db.Text
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([companyId])
  @@index([leaveTypeId])
  @@index([status])
  @@index([startDate])
  @@map("leave_requests")
}

