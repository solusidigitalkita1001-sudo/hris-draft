// ============================================================
// D.2 ENGAGEMENT: SURVEY / POLLING
// ============================================================

model Survey {
  id                String         @id @default(uuid()) @db.VarChar(36)
  companyId         String         @map("company_id") @db.VarChar(36)
  createdById       String         @map("created_by_id") @db.VarChar(36)
  type              SurveyType     @default(SURVEY)
  title             String         @db.VarChar(255)
  description       String?        @db.Text
  status            SurveyStatus   @default(DRAFT)
  anonymous         Boolean        @default(false)
  allowMultipleSubmission Boolean  @default(false)
  startDate         DateTime?      @map("start_date") @db.Date
  endDate           DateTime?      @map("end_date")   @db.Date
  targetAudienceIds String?        @db.Text /// JSON array employeeIds (optional)
  maxResponses      Int?           @map("max_responses") /// null = unlimited
  totalResponses    Int            @default(0)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  questions SurveyQuestion[]
  responses SurveyResponse[]

  @@index([companyId, status])
  @@index([status, startDate, endDate])
  @@map("surveys")
}

/// 1 survey punya banyak pertanyaan (ordered position)
model SurveyQuestion {
  id           String              @id @default(uuid()) @db.VarChar(36)
  surveyId     String              @map("survey_id") @db.VarChar(36)
  position     Int                 @default(0)
  questionText String              @map("question_text") @db.Text
  type         SurveyQuestionType  @default(SINGLE_CHOICE)
  optionsJson  String?             @map("options_json") @db.Text /// JSON array string [{label:"Sangat Puas",value:"A"}]
  required     Boolean             @default(true)
  minSelect    Int?                @map("min_select") /// MULTIPLE_CHOICE min jawaban (default 1)
  maxSelect    Int?                @map("max_select") /// MULTIPLE max jawaban (default = options.len)
  createdAt    DateTime            @default(now()) @map("created_at")

  survey  Survey        @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers SurveyAnswer[]

  @@index([surveyId, position])
  @@map("survey_questions")
}

/// 1 user submit 1 response (non-anonymous punya userId, anonymous = null)
model SurveyResponse {
  id           String      @id @default(uuid()) @db.VarChar(36)
  surveyId     String      @map("survey_id") @db.VarChar(36)
  respondentId String?     @map("respondent_id") @db.VarChar(36) /// null = anonymous=true
  submittedAt  DateTime    @default(now()) @map("submitted_at")

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  respondent User?  @relation(fields: [respondentId], references: [id], onDelete: SetNull)
  answers    SurveyAnswer[]

  @@index([surveyId])
  @@index([respondentId, surveyId])
  @@unique([respondentId, surveyId])
  @@map("survey_responses")
}

/// Per question per response = jawaban (SINGLE/MULTIPLE pilih value option, TEXT = bebas, RATING = numeric)
model SurveyAnswer {
  id            String  @id @default(uuid()) @db.VarChar(36)
  responseId    String  @map("response_id") @db.VarChar(36)
  questionId    String  @map("question_id") @db.VarChar(36)
  textValue     String? @db.Text                     /// TEXT type, atau concatenated MULTIPLE delimiter comma
  numberValue   Decimal? @db.Decimal(10, 2)          /// RATING_1_5 type
  selectedJson  String? @map("selected_json") @db.Text /// JSON array values MULTIPLE_CHOICE

  response SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("survey_answers")
}

