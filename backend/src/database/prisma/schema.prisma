// ============================================================
// D.3 E-SIGNATURE PROVIDER WRAPPER ENUMS
// ============================================================

/// D.3 E-Signature provider list: internal built-in OR eksternal provider resmi Indonesia (Privy/Digisign sesuai UU ITE)
enum ESignatureProvider {
  INTERNAL        /// Sign built-in (non-legal audit trail fallback only, NOT recommended untuk kontrak kerja)
  PRIVY_ID        /// PrivyID - provider resmi OJK/Kemenkominfo
  DIGISIGN        /// Digisign - provider e-sign bersertifikat
  PERURI          /// Peruri e-sign (instansi pemerintah)
  OTHER
}

enum ESignatureStatus {
  DRAFT           /// Dokumen draft, belum dikirim sign
  REQUESTED       /// Sudah dikirim ke signer via provider (pending sign)
  SIGNED          /// Signer sudah menandatangani
  VERIFIED        /// Provider sudah verifikasi audit trail sah
  REJECTED        /// Signer menolak menandatangani
  EXPIRED         /// Link sign kadaluwarsa (default 30 hari)
  FAILED          /// Error provider / sign error
  CANCELLED       /// Pembatalan oleh pengirim sebelum sign
}

/// D.3 Level verifikasi e-signature (ketat -> longgar)
enum ESignatureVerificationLevel {
  CERTIFIED       /// Tertinggi: Kemenkominfo / OJK registered provider + e-KYC + audit trail (wajib kontrak kerja)
  AUDIT_TRAIL     /// Menengah: Timestamp + hash chain + signer identity log (bukan certificate-based)
  BASIC           /// Fallback internal: basic check email + no audit (not legal)
}

