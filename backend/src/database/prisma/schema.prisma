  filePath    String             @map("file_path") @db.VarChar(500)
  mimeType    String             @map("mime_type") @db.VarChar(100)
  fileSize    Int                @map("file_size")
  status      DocumentStatus     @default(ACTIVE)
  visibility  DocumentVisibility @default(INTERNAL)
  version     Int                @default(1)
  expiresAt   DateTime?          @map("expires_at")
  uploadedBy  String             @map("uploaded_by") @db.VarChar(36)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  deletedAt   DateTime?          @map("deleted_at")

  company                     Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  group                       CompanyGroup?                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  category                    DocumentCategory             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  employee                    Employee?                    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  uploader                    User                         @relation("DocumentUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)
  signatures                  DocumentSignature[]
  accessLogs                  DocumentAccessLog[]
  esignatureTransactions      ESignatureTransaction[]
  performanceResultAttachment PerformanceResultAttachment?

  @@index([companyId, status])
  @@index([categoryId])
  @@index([employeeId])
  @@index([uploadedBy])
  @@index([expiresAt])
  @@map("documents")
}

/// Signature trail for documents
model DocumentSignature {
  id         String   @id @default(uuid()) @db.VarChar(36)
  documentId String   @map("document_id") @db.VarChar(36)
  signerId   String   @map("signer_id") @db.VarChar(36)
  signedAt   DateTime @default(now()) @map("signed_at")
  createdAt  DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  signer   User     @relation(fields: [signerId], references: [id], onDelete: Cascade)
  /// D.3 ESignatureTransaction (provider wrapper per signature: INTERNAL / PRIVY / DIGISIGN)
  esignatureTransactions ESignatureTransaction[]

  @@index([documentId])
  @@index([signerId])
  @@map("document_signatures")
}

/// Access log for document read/download activities
model DocumentAccessLog {
  id         String               @id @default(uuid()) @db.VarChar(36)
  documentId String               @map("document_id") @db.VarChar(36)
  accessedBy String               @map("accessed_by") @db.VarChar(36)
  action     DocumentAccessAction
  createdAt  DateTime             @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [accessedBy], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([accessedBy])
  @@index([action])
  @@map("document_access_logs")
}

