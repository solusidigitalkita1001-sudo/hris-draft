/// D.3 E-Signature Transaction — wrapper extend existing DocumentSignature table (support external providers internal/external provider signed)
model ESignatureTransaction {
  id                         String                       @id @default(uuid()) @db.VarChar(36)
  companyId                  String                     @map("company_id") @db.VarChar(36)
  documentSignatureId          String                     @map("document_signature_id") @db.VarChar(36) /// extend DocumentSignature.id existing
  documentId               String                     @map("document_id") @db.VarChar(36)
  signerUserId             String                     @map("signer_user_id") @db.VarChar(36)
  provider                   ESignatureProvider         @default(INTERNAL)
  status                       ESignatureStatus             @default(DRAFT)
  verificationLevel         ESignatureVerificationLevel @default(BASIC)
  providerReference            String?                @map("provider_ref") @db.VarChar(100)     /// transaction id dari eksternal provider (Privy Doc ID, Digisign Sign ID)
  signerNik                String?                @db.VarChar(32)                  /// NIK 16 digit jika perlu untuk certified provider
  signerEmail             String?                @db.VarChar(255)                /// signer email
  signerPhone           String?                @db.VarChar(20)                /// signer phone WA untuk OTP
  requestSentAt              DateTime?           @map("request_sent_at")
  signedAt                 DateTime?           @map("signed_at")
  verifiedAt                DateTime?          @map("verified_at")
  expiredAt               DateTime?         @map("expired_at")           /// default = requestedAt +30 hari
  callbackPayloadJson        String?          @map("callback_payload_json") @db.Text /// raw callback dari provider (encrypted DB)
  documentHashSha256       String?         @map("document_hash_sha256") @db.VarChar(64)     /// integrity hash check verify
  signingUrl            String?               @db.VarChar(700)            /// sign URL provider / internal sign link
  costAmountRupiah         Decimal?       @db.Decimal(15, 2)            /// provider cost/ biaya provider per dokumen
  notes                    String?          @db.Text
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  company            Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documentSignature DocumentSignature  @relation(fields: [documentSignatureId], references: [id], onDelete: Cascade)
  document         Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  signer             User                @relation(fields: [signerUserId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@index([provider, status])
  @@index([documentId])
  @@unique([provider, providerReference])
  @@map("esignature_transactions")
}

