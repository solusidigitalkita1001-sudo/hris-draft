  authorId         String               @map("author_id") @db.VarChar(36) /// User.id pembuat (HR / ADMIN)
  audienceType     AnnouncementAudience @default(COMPANY_WIDE)
  departmentIds    String?              @db.Text /// JSON array uuid department (audience DEPARTMENT_ONLY)
  branchIds        String?              @db.Text /// JSON array uuid branch (BRANCH_ONLY)
  positionIds      String?              @db.Text /// JSON array uuid position (POSITION_ONLY)
  employeeIds      String?              @db.Text /// JSON array uuid employee (EMPLOYEE_SPECIFIC)
