// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// COMPANY GROUP STRUCTURE
// ============================================================

/// Holding company / parent organization
model CompanyGroup {
  id        String    @id @default(uuid()) @db.VarChar(36)
  name      String    @db.VarChar(255)
  code      String    @unique @db.VarChar(50)
  taxId     String?   @map("tax_id") @db.VarChar(50)
  address   String?   @db.Text
  phone     String?   @db.VarChar(50)
  email     String?   @db.VarChar(255)
  logo      String?   @db.VarChar(500)
  website   String?   @db.VarChar(500)
  status    Status    @default(ACTIVE)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  companies           Company[]
  groupPolicies       GroupPolicy[]
  groupSettings       GroupSetting[]
  roles               Role[]
  userCompanyAccesses UserCompanyAccess[]
  assetCategories     AssetCategory[]
  documentCategories  DocumentCategory[]
  documents           Document[]

  @@map("company_groups")
}

/// Company entity under a group
model Company {
  id              String    @id @default(uuid()) @db.VarChar(36)
  groupId         String    @map("group_id") @db.VarChar(36)
  name            String    @db.VarChar(255)
  code            String    @unique @db.VarChar(50)
  taxId           String?   @map("tax_id") @db.VarChar(50)
  address         String?   @db.Text
  phone           String?   @db.VarChar(50)
  email           String?   @db.VarChar(255)
  logo            String?   @db.VarChar(500)
  website         String?   @db.VarChar(500)
  timezone        String    @default("Asia/Jakarta") @db.VarChar(50)
  dateFormat      String    @default("DD/MM/YYYY") @map("date_format") @db.VarChar(20)
  fiscalYearStart String    @default("01-01") @map("fiscal_year_start") @db.VarChar(5)
  currency        String    @default("IDR") @db.VarChar(10)
  status          Status    @default(ACTIVE)
  operationalStatus CompanyOperationalStatus @default(ACTIVE) @map("operational_status")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  group                                 CompanyGroup                           @relation(fields: [groupId], references: [id], onDelete: Restrict)
  branches                              Branch[]
  divisions                             Division[]
  departments                           Department[]
  subDepartments                        SubDepartment[]
  positions                             Position[]
  employees                             Employee[]
  roles                                 Role[]
  userCompanyAccesses                   UserCompanyAccess[]
  companySettings                       CompanySetting[]
  auditLogs                             AuditLog[]
  salaryComponents                      SalaryComponent[]
  employeeSalaries                      EmployeeSalary[]
  payrollPeriods                        PayrollPeriod[]
  payrollRuns                           PayrollRun[]
  payslips                              Payslip[]
  benefitPlans                          BenefitPlan[]
  benefitEnrollments                    BenefitEnrollment[]
  performanceFormulas                   PerformanceFormula[]
  performanceIndicators                 PerformanceIndicator[]
  performanceGradeRules                 PerformanceGradeRule[]
  performanceMethods                    PerformanceMethod[]
  performanceMethodVersions             PerformanceMethodVersion[]
  performanceComponents                 PerformanceComponent[]
  performancePeriods                    PerformancePeriod[]
  performancePlanningAssignments        PerformancePlanningAssignment[]
  performancePlanningTargets            PerformancePlanningTarget[]
  performancePlanningTargetProgresses   PerformancePlanningTargetProgress[]
  performancePlanningEvidences          PerformancePlanningEvidence[]
  performanceResults                    PerformanceResult[]
  performanceCalibrationSessions        PerformanceCalibrationSession[]
  performanceCalibrationParticipants    PerformanceCalibrationParticipant[]
  performanceCalibrationDecisions       PerformanceCalibrationDecision[]
  performanceResultDisputes             PerformanceResultDispute[]
  performanceDevelopmentRecommendations PerformanceDevelopmentRecommendation[]
  performanceResultAttachments          PerformanceResultAttachment[]
  performanceAutomationSchedules        PerformanceAutomationSchedule[]
  reviewCycles                          ReviewCycle[]
  performanceReviews                    PerformanceReview[]
  feedbackRequests                      FeedbackRequest[]
  goals                                 Goal[]
  trainingCategories                    TrainingCategory[]
  trainingCourses                       TrainingCourse[]
  trainingEnrollments                   TrainingEnrollment[]
  jobPostings                           JobPosting[]
  candidates                            Candidate[]
  jobApplications                       JobApplication[]
  interviews                            Interview[]
  attendances                           Attendance[]
  attendanceCorrections                 AttendanceCorrection[]
  /// B.7 Face Rec audit trail
  attendanceFaceLogs                    AttendanceFaceLog[]
  employeeFaceProfiles                  EmployeeFaceProfile[]
  /// C.1 Claim Category Limit
  claimCategoryLimits                   ClaimCategoryLimit[]
  /// C.4 Earned Wage Access
  earnedWageAccesses                    EarnedWageAccess[]
  /// C.5 Daily Activity
  dailyActivities                       DailyActivity[]
  /// C.6 Task Assignments (company-level)
  taskAssignments                       TaskAssignment[]
  /// C.7 Asset Patrol Logs
  assetPatrolLogs                       AssetPatrolLog[]
  overtimeRequests                      OvertimeRequest[]
  /// D.1 Engagement Announcements
  announcements                         Announcement[]
  /// D.2 Engagement Surveys
  surveys                               Survey[]
  /// D.3 E-Signature wrapper transactions
  esignatureTransactions               ESignatureTransaction[]
  leaveTypes                            LeaveType[]
  leaveBalances                         LeaveBalance[]
  leaveRequests                         LeaveRequest[]
  onboardingChecklists                  OnboardingChecklist[]
  resignations                          Resignation[]
  assets                                Asset[]
  workCalendars                         WorkCalendar[]
  nationalHolidays                      NationalHoliday[]
  notifications                         Notification[]
  permissionRequests                    PermissionRequest[]
  loanTypes                             LoanType[]
  loans                                 Loan[]
  workflowTemplates                     WorkflowTemplate[]
  workflowInstances                     WorkflowInstance[]
  businessTrips                         BusinessTrip[]
  travelAdvances                        TravelAdvance[]
  expenseClaims                         ExpenseClaim[]
  reimbursements                        Reimbursement[]
  documentCategories                    DocumentCategory[]
  documents                             Document[]
  careerTransactions                    EmployeeCareerTransaction[]
  employeeCompanyAssignments            EmployeeCompanyAssignment[]
  branchAttendancePolicies              BranchAttendancePolicy[]
  shiftFormulas                         ShiftFormula[]
  shiftSwapRequests                     ShiftSwapRequest[]
  shiftOverrides                        EmployeeShiftOverride[]
  roleMenuAccesses                      RoleMenuAccess[]
  roleDataScopes                        RoleDataScope[]
  taxBrackets                           TaxBracket[]
  ptkpTables                            PtkpTable[]
  bpjsReferences                        BpjsReference[]
  employeeFamilies                      EmployeeFamily[]
  employeeEducations                    EmployeeEducation[]
  employeeEmergencyContacts             EmployeeEmergencyContact[]
  employeeTrainings                     EmployeeTraining[]
  employeeSkills                        EmployeeSkill[]
  employeeExperiences                   EmployeeExperience[]
  employeeAttachments                   EmployeeAttachment[]
  employeeBankAccounts                  EmployeeBankAccount[]
  assetAssignments                      AssetAssignment[]

  @@index([groupId])
  @@index([code])
  @@index([status])
  @@map("companies")
}

/// Physical branch / location
model Branch {
  id        String    @id @default(uuid()) @db.VarChar(36)
  companyId String    @map("company_id") @db.VarChar(36)
  name      String    @db.VarChar(255)
  code      String    @unique @db.VarChar(50)
  address   String?   @db.Text
  phone     String?   @db.VarChar(50)
  email     String?   @db.VarChar(255)
  timezone  String    @default("Asia/Jakarta") @db.VarChar(50)
  latitude  Float?
  longitude Float?
  status    Status    @default(ACTIVE)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  company                Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employees              Employee[]
  attendances            Attendance[]
  attendancePolicies     BranchAttendancePolicy[]
  careerTransactionsFrom EmployeeCareerTransaction[] @relation("CareerFromBranch")
  careerTransactionsTo   EmployeeCareerTransaction[] @relation("CareerToBranch")
  /// C.5+C.6 Daily Activities + Tasks scoped per branch
  dailyActivities        DailyActivity[]
  taskAssignments        TaskAssignment[]

  @@index([companyId])
  @@index([code])
  @@map("branches")
}

/// Functional vertical division
model Division {
  id          String    @id @default(uuid()) @db.VarChar(36)
  companyId   String    @map("company_id") @db.VarChar(36)
  name        String    @db.VarChar(255)
  code        String    @unique @db.VarChar(50)
  headId      String?   @map("head_id") @db.VarChar(36)
  description String?   @db.Text
  status      Status    @default(ACTIVE)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  head        Employee?    @relation("DivisionHead", fields: [headId], references: [id], onDelete: SetNull)
  departments Department[]

  @@index([companyId])
  @@index([code])
  @@map("divisions")
}

/// Department under division
model Department {
  id          String    @id @default(uuid()) @db.VarChar(36)
  divisionId  String?   @map("division_id") @db.VarChar(36)
  companyId   String    @map("company_id") @db.VarChar(36)
  parentId    String?   @map("parent_id") @db.VarChar(36)
  name        String    @db.VarChar(255)
  code        String    @unique @db.VarChar(50)
  headId      String?   @map("head_id") @db.VarChar(36)
  description String?   @db.Text
  costCenter  String?   @map("cost_center") @db.VarChar(50)
  status      Status    @default(ACTIVE)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  division               Division?                   @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  company                Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parent                 Department?                 @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children               Department[]                @relation("DepartmentHierarchy")
  head                   Employee?                   @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  subDepartments         SubDepartment[]
  positions              Position[]
  employees              Employee[]
  jobPostings            JobPosting[]
  careerTransactionsFrom EmployeeCareerTransaction[] @relation("CareerFromDepartment")
  careerTransactionsTo   EmployeeCareerTransaction[] @relation("CareerToDepartment")

  @@index([divisionId])
  @@index([companyId])
  @@index([parentId])
  @@index([code])
  @@map("departments")
}

/// Sub-department / team level
model SubDepartment {
  id           String    @id @default(uuid()) @db.VarChar(36)
  departmentId String    @map("department_id") @db.VarChar(36)
  companyId    String    @map("company_id") @db.VarChar(36)
  name         String    @db.VarChar(255)
  code         String    @unique @db.VarChar(50)
  headId       String?   @map("head_id") @db.VarChar(36)
  description  String?   @db.Text
  status       Status    @default(ACTIVE)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  head       Employee?  @relation("SubDepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  employees  Employee[]

  @@index([departmentId])
  @@index([companyId])
  @@index([code])
  @@map("sub_departments")
}

/// Job position
model Position {
  id           String    @id @default(uuid()) @db.VarChar(36)
  departmentId String?   @map("department_id") @db.VarChar(36)
  companyId    String    @map("company_id") @db.VarChar(36)
  name         String    @db.VarChar(255)
  code         String    @unique @db.VarChar(50)
  gradeLevel   Int?      @map("grade_level")
  minSalary    Decimal?  @map("min_salary") @db.Decimal(15, 2)
  maxSalary    Decimal?  @map("max_salary") @db.Decimal(15, 2)
  reportsToId  String?   @map("reports_to_id") @db.VarChar(36)
  description  String?   @db.Text
  requirements String?   @db.Text
  status       Status    @default(ACTIVE)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  department             Department?                 @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  company                Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  reportsTo              Position?                   @relation("PositionHierarchy", fields: [reportsToId], references: [id], onDelete: SetNull)
  subordinates           Position[]                  @relation("PositionHierarchy")
  employees              Employee[]
  jobPostings            JobPosting[]
  careerTransactionsFrom EmployeeCareerTransaction[] @relation("CareerFromPosition")
  careerTransactionsTo   EmployeeCareerTransaction[] @relation("CareerToPosition")

  @@index([departmentId])
  @@index([companyId])
  @@index([code])
  @@map("positions")
}

// ============================================================
// COMPENSATION: SALARY COMPONENTS & PAYROLL
// ============================================================

/// Master data for salary components (Gaji Pokok, Tunjangan Makan, BPJS, etc)
model SalaryComponent {
  id                String     @id @default(uuid()) @db.VarChar(36)
  companyId         String     @map("company_id") @db.VarChar(36)
  name              String     @db.VarChar(255)
  code              String     @unique @db.VarChar(50)
  type              SalaryType @default(ALLOWANCE)
  calculationMethod String     @default("FIXED") @map("calculation_method") @db.VarChar(50)
  amount            Decimal?   @db.Decimal(15, 2)
  ratePercent       Decimal?   @map("rate_percent") @db.Decimal(5, 2)
  isTaxable         Boolean    @default(true) @map("is_taxable")
  isProrated        Boolean    @default(false) @map("is_prorated")
  isActive          Boolean    @default(true) @map("is_active")
  description       String?    @db.Text
  sortOrder         Int        @default(0) @map("sort_order")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  deletedAt         DateTime?  @map("deleted_at")

  company           Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employeeSalaries  EmployeeSalaryComponent[]
  payslipComponents PayslipComponent[]

  @@index([companyId])
  @@index([code])
  @@index([type])
  @@map("salary_components")
}

/// Employee salary structure (which components apply to which employee)
model EmployeeSalary {
  id            String    @id @default(uuid()) @db.VarChar(36)
  employeeId    String    @map("employee_id") @db.VarChar(36)
  companyId     String    @map("company_id") @db.VarChar(36)
  effectiveDate DateTime  @map("effective_date")
  baseSalary    Decimal   @map("base_salary") @db.Decimal(15, 2)
  currency      String    @default("IDR") @db.VarChar(10)
  isActive      Boolean   @default(true) @map("is_active")
  notes         String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  employee   Employee                  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  company    Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  components EmployeeSalaryComponent[]
  payslips   Payslip[]

  @@index([employeeId])
  @@index([companyId])
  @@index([effectiveDate])
  @@map("employee_salaries")
}

/// Many-to-many: EmployeeSalary x SalaryComponent with amount
model EmployeeSalaryComponent {
  id                String   @id @default(uuid()) @db.VarChar(36)
  employeeSalaryId  String   @map("employee_salary_id") @db.VarChar(36)
  salaryComponentId String   @map("salary_component_id") @db.VarChar(36)
  amount            Decimal  @db.Decimal(15, 2)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")

  employeeSalary  EmployeeSalary  @relation(fields: [employeeSalaryId], references: [id], onDelete: Cascade)
  salaryComponent SalaryComponent @relation(fields: [salaryComponentId], references: [id], onDelete: Restrict)

  @@unique([employeeSalaryId, salaryComponentId])
  @@map("employee_salary_components")
}

/// Payroll periods (monthly, biweekly, etc)
model PayrollPeriod {
  id        String           @id @default(uuid()) @db.VarChar(36)
  companyId String           @map("company_id") @db.VarChar(36)
  name      String           @db.VarChar(255)
  code      String           @unique @db.VarChar(50)
  frequency PayrollFrequency @default(MONTHLY)
  startDate DateTime         @map("start_date")
  endDate   DateTime         @map("end_date")
  payDate   DateTime         @map("pay_date")
  status                  PayrollStatus    @default(DRAFT)
  attendanceReviewedAt    DateTime?        @map("attendance_reviewed_at")
  attendanceReviewedBy    String?          @map("attendance_reviewed_by") @db.VarChar(36)
  notes     String?          @db.Text
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  deletedAt DateTime?        @map("deleted_at")

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  payrollRuns PayrollRun[]
  /// C.4 EWA: List request tarik gaji awal yang reference periode ini
  earnedWageAccesses EarnedWageAccess[]

  @@index([companyId])
  @@index([code])
  @@index([status])
  @@map("payroll_periods")
}

/// Payroll run — generated from a period
model PayrollRun {
  id              String           @id @default(uuid()) @db.VarChar(36)
  periodId        String           @map("period_id") @db.VarChar(36)
  companyId       String           @map("company_id") @db.VarChar(36)
  name            String           @db.VarChar(255)
  runNumber       Int              @map("run_number")
  totalEmployees  Int              @default(0) @map("total_employees")
  totalEarnings   Decimal          @default(0) @map("total_earnings") @db.Decimal(15, 2)
  totalDeductions Decimal          @default(0) @map("total_deductions") @db.Decimal(15, 2)
  totalNetPay     Decimal          @default(0) @map("total_net_pay") @db.Decimal(15, 2)
  status          PayrollRunStatus @default(DRAFT)
  approvedBy      String?          @map("approved_by") @db.VarChar(36)
  approvedAt      DateTime?        @map("approved_at")
  disbursedBy     String?          @map("disbursed_by") @db.VarChar(36)
  disbursedAt     DateTime?        @map("disbursed_at")
  notes           String?          @db.Text
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")

  period   PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  company  Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  payslips Payslip[]
  /// C.4 EWA: list employee tarik gaji awal yang di-deducted di run ini
  earnedWageAccesses EarnedWageAccess[]

  @@index([periodId])
  @@index([companyId])
  @@index([status])
  @@map("payroll_runs")
}

/// Payslip — one per employee per payroll run
model Payslip {
  id               String        @id @default(uuid()) @db.VarChar(36)
  payrollRunId     String        @map("payroll_run_id") @db.VarChar(36)
  employeeId       String        @map("employee_id") @db.VarChar(36)
  companyId        String        @map("company_id") @db.VarChar(36)
  employeeSalaryId String?       @map("employee_salary_id") @db.VarChar(36)
  baseSalary       Decimal       @map("base_salary") @db.Decimal(15, 2)
  totalEarnings    Decimal       @default(0) @map("total_earnings") @db.Decimal(15, 2)
  totalDeductions  Decimal       @default(0) @map("total_deductions") @db.Decimal(15, 2)
  netPay           Decimal       @default(0) @map("net_pay") @db.Decimal(15, 2)
  workDays         Int           @default(0) @map("work_days")
  presentDays      Int           @default(0) @map("present_days")
  leaveDays        Int           @default(0) @map("leave_days")
  absentDays       Int           @default(0) @map("absent_days")
  overtimeHours    Decimal       @default(0) @map("overtime_hours") @db.Decimal(10, 2)
  status           PayslipStatus @default(DRAFT)
  notes            String?       @db.Text
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  payrollRun        PayrollRun         @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  employee          Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employeeSalary    EmployeeSalary?    @relation(fields: [employeeSalaryId], references: [id], onDelete: SetNull)
  components        PayslipComponent[]
  benefitDeductions BenefitDeduction[]

  @@index([payrollRunId])
  @@index([employeeId])
  @@index([companyId])
  @@map("payslips")
}

/// Breakdown of each salary component on a payslip
model PayslipComponent {
  id                String     @id @default(uuid()) @db.VarChar(36)
  payslipId         String     @map("payslip_id") @db.VarChar(36)
  salaryComponentId String     @map("salary_component_id") @db.VarChar(36)
  name              String     @db.VarChar(255)
  type              SalaryType
  amount            Decimal    @db.Decimal(15, 2)
  isTaxable         Boolean    @default(true) @map("is_taxable")
  createdAt         DateTime   @default(now()) @map("created_at")

  payslip         Payslip         @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  salaryComponent SalaryComponent @relation(fields: [salaryComponentId], references: [id], onDelete: Restrict)

  @@index([payslipId])
  @@map("payslip_components")
}

// ============================================================
// PAYROLL REFERENCE TABLES (B.1 PPh 21, B.2 THR, B.3 BPJS)
// ============================================================

/// PPh 21 progressive tax bracket (UU HPP 2022 or latest peraturan DJP).
/// Global scope (companyId=null) or per-company custom override.
model TaxBracket {
  id         String   @id @default(uuid()) @db.VarChar(36)
  companyId  String?  @map("company_id") @db.VarChar(36)
  year       Int
  level      Int      /// Tier sequential number (1 lowest → 5 highest)
  upperBound  Decimal  @map("upper_bound") @db.Decimal(18, 2) /// Max PKP in this bracket; Infinity = 999e15 stored as sentinel
  ratePercent Decimal @map("rate_percent") @db.Decimal(5, 4)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  company    Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, year, level])
  @@index([year])
  @@map("tax_brackets")
}

/// PTKP = Penghasilan Tidak Kena Pajak per status pernikahan & jumlah tanggungan.
/// (TK/0 = single no dependents, K/1 = married +1 child, capped MAX 3 tanggungan).
model PtkpTable {
  id             String   @id @default(uuid()) @db.VarChar(36)
  companyId      String?  @map("company_id") @db.VarChar(36)
  year           Int
  maritalStatus  String   @map("marital_status") @db.VarChar(10) /// TK/K
  dependents     Int      /// 0..MAX_DEPENDENTS(3)
  amount         Decimal  @db.Decimal(15, 2) /// Rupiah per tahun
  description    String?  @db.VarChar(255)    /// e.g. "K/3 (Menikah 3 anak)"
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company        Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, year, maritalStatus, dependents])
  @@index([year])
  @@map("ptkp_tables")
}

enum JKKRiskClass {
  I      /// Resiko sangat rendah (perkantoran)   → JKK 0.24%
  II     /// Resiko rendah (perdagangan)        → JKK 0.54%
  III    /// Resiko sedang (manufaktur ringan)  → JKK 0.89%
  IV     /// Resiko tinggi (manufaktur berat)   → JKK 1.27%
  V      /// Resiko sangat tinggi (tambang/logistik) → JKK 1.74%
}

enum BankCode {
  BCA      /// Bank Central Asia (BCA KlikBCA bulk)
  MANDIRI  /// Bank Mandiri
  BNI      /// Bank Negara Indonesia (BNI e-Collect)
  OTHER    /// Bank custom lainnya (input manual bankName)
}

/// BPJS Ketenagakerjaan + Kesehatan config defaults per year, or custom per-company.
model BpjsReference {
  id                String      @id @default(uuid()) @db.VarChar(36)
  companyId         String?     @map("company_id") @db.VarChar(36)
  year              Int
  jkkRiskClass      JKKRiskClass @default(I) @map("jkk_risk_class")
  jkkRatePercent    Decimal     @map("jkk_rate_percent") @db.Decimal(5, 4)
  jkmRatePercent    Decimal     @map("jkm_rate_percent") @db.Decimal(5, 4)
  jhtEmployerPercent Decimal    @map("jht_employer_percent") @db.Decimal(5, 4)
  jhtEmployeePercent Decimal    @map("jht_employee_percent") @db.Decimal(5, 4)
  jpEmployerPercent  Decimal    @map("jp_employer_percent") @db.Decimal(5, 4)
  jpEmployeePercent  Decimal    @map("jp_employee_percent") @db.Decimal(5, 4)
  jpWageCap          Decimal    @map("jp_wage_cap") @db.Decimal(15, 2)  /// Upah batas atas Jaminan Pensiun
  jknEmployerPercent Decimal    @map("jkn_employer_percent") @db.Decimal(5, 4)
  jknEmployeePercent Decimal    @map("jkn_employee_percent") @db.Decimal(5, 4)
  jknWageCap         Decimal    @map("jkn_wage_cap") @db.Decimal(15, 2)  /// Upah batas atas BPJS Kesehatan
  isActive           Boolean    @default(true) @map("is_active")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  company            Company?   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, year, jkkRiskClass])
  @@index([year])
  @@map("bpjs_references")
}

/// Multiple bank accounts per employee (B.6 Multibank Disbursement).
/// Satu karyawan bisa punya beberapa rekening (mis. BCA gaji pokok, BNI tunjangan proyek).
/// Disbursement pilih yang `isPrimary=true`, atau fallback ke legacy fields Employee.bankName.
model EmployeeBankAccount {
  id              String    @id @default(uuid()) @db.VarChar(36)
  employeeId      String    @map("employee_id") @db.VarChar(36)
  companyId       String    @map("company_id") @db.VarChar(36)
  bankCode        BankCode  @default(OTHER) @map("bank_code")
  bankName        String?   @map("bank_name") @db.VarChar(255)  /// Free text bank custom jika code=OTHER
  accountNumber   String    @map("account_number") @db.VarChar(50)
  accountHolder   String    @map("account_holder") @db.VarChar(255)
  isPrimary       Boolean   @default(false) @map("is_primary")   /// Cuma SATU per employee (validasi app level)
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([employeeId, bankCode]) /// Satu karyawan cuma boleh 1 rekening per bank code
  @@index([employeeId])
  @@index([companyId])
  @@index([bankCode])
  @@map("employee_bank_accounts")
}

// ============================================================
// BENEFITS
// ============================================================

/// Benefit plan (BPJS, insurance, THR, etc)
model BenefitPlan {
  id                   String    @id @default(uuid()) @db.VarChar(36)
  companyId            String    @map("company_id") @db.VarChar(36)
  name                 String    @db.VarChar(255)
  code                 String    @unique @db.VarChar(50)
  type                 String    @db.VarChar(50)
  description          String?   @db.Text
  provider             String?   @db.VarChar(255)
  isTaxable            Boolean   @default(false) @map("is_taxable")
  employeeContribution Decimal   @default(0) @map("employee_contribution") @db.Decimal(5, 2)
  employerContribution Decimal   @default(0) @map("employer_contribution") @db.Decimal(5, 2)
  maxAmount            Decimal?  @map("max_amount") @db.Decimal(15, 2)
  isActive             Boolean   @default(true) @map("is_active")
  effectiveDate        DateTime? @map("effective_date")
  expiryDate           DateTime? @map("expiry_date")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  enrollments BenefitEnrollment[]

  @@index([companyId])
  @@index([code])
  @@map("benefit_plans")
}

/// Employee enrollment in a benefit plan
model BenefitEnrollment {
  id              String                  @id @default(uuid()) @db.VarChar(36)
  benefitPlanId   String                  @map("benefit_plan_id") @db.VarChar(36)
  employeeId      String                  @map("employee_id") @db.VarChar(36)
  companyId       String                  @map("company_id") @db.VarChar(36)
  enrollmentDate  DateTime                @default(now()) @map("enrollment_date")
  effectiveDate   DateTime                @map("effective_date")
  expiryDate      DateTime?               @map("expiry_date")
  status          BenefitEnrollmentStatus @default(ACTIVE)
  coverageDetails String?                 @map("coverage_details") @db.Text
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  deletedAt       DateTime?               @map("deleted_at")

  benefitPlan       BenefitPlan        @relation(fields: [benefitPlanId], references: [id], onDelete: Restrict)
  employee          Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  benefitDeductions BenefitDeduction[]

  @@index([benefitPlanId])
  @@index([employeeId])
  @@index([companyId])
  @@index([status])
  @@map("benefit_enrollments")
}

/// Per-payslip benefit deduction (calculated amount)
model BenefitDeduction {
  id                  String   @id @default(uuid()) @db.VarChar(36)
  payslipId           String   @map("payslip_id") @db.VarChar(36)
  benefitEnrollmentId String   @map("benefit_enrollment_id") @db.VarChar(36)
  employeeAmount      Decimal  @map("employee_amount") @db.Decimal(15, 2)
  employerAmount      Decimal  @default(0) @map("employer_amount") @db.Decimal(15, 2)
  totalAmount         Decimal  @map("total_amount") @db.Decimal(15, 2)
  createdAt           DateTime @default(now()) @map("created_at")

  payslip           Payslip           @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  benefitEnrollment BenefitEnrollment @relation(fields: [benefitEnrollmentId], references: [id], onDelete: Restrict)

  @@index([payslipId])
  @@index([benefitEnrollmentId])
  @@map("benefit_deductions")
}

// ============================================================
// PERFORMANCE MANAGEMENT
// ============================================================

/// Performance configuration method (e.g. Annual Balanced Scorecard)
model PerformanceMethod {
  id                  String                  @id @default(uuid()) @db.VarChar(36)
  companyId           String                  @map("company_id") @db.VarChar(36)
  name                String                  @db.VarChar(255)
  code                String                  @db.VarChar(50)
  description         String?                 @db.Text
  status              PerformanceMethodStatus @default(DRAFT)
  latestVersionNumber Int                     @default(0) @map("latest_version_number")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  deletedAt           DateTime?               @map("deleted_at")

  company                       Company                         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  versions                      PerformanceMethodVersion[]
  periods                       PerformancePeriod[]
  PerformancePlanningAssignment PerformancePlanningAssignment[]
  PerformanceResult             PerformanceResult[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@map("performance_methods")
}

/// Frozen-capable method version used by periods
model PerformanceMethodVersion {
  id                         String                         @id @default(uuid()) @db.VarChar(36)
  methodId                   String                         @map("method_id") @db.VarChar(36)
  companyId                  String                         @map("company_id") @db.VarChar(36)
  gradeRuleId                String?                        @map("grade_rule_id") @db.VarChar(36)
  reviewWorkflowTemplateId   String?                        @map("review_workflow_template_id") @db.VarChar(36)
  approvalWorkflowTemplateId String?                        @map("approval_workflow_template_id") @db.VarChar(36)
  versionNumber              Int                            @map("version_number")
  status                     PerformanceMethodVersionStatus @default(DRAFT)
  summary                    String?                        @db.Text
  weightMode                 PerformanceWeightMode          @default(STRICT_100) @map("weight_mode")
  scoreAggregation           PerformanceScoreAggregation    @default(WEIGHTED_AVERAGE) @map("score_aggregation")
  minimumScore               Decimal?                       @map("minimum_score") @db.Decimal(5, 2)
  maximumScore               Decimal?                       @map("maximum_score") @db.Decimal(5, 2)
  normalizationRule          Json?                          @map("normalization_rule")
  publishedAt                DateTime?                      @map("published_at")
  createdAt                  DateTime                       @default(now()) @map("created_at")
  updatedAt                  DateTime                       @updatedAt @map("updated_at")

  method                                PerformanceMethod                      @relation(fields: [methodId], references: [id], onDelete: Cascade)
  company                               Company                                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  components                            PerformanceComponent[]
  reviewWorkflowTemplate                WorkflowTemplate?                      @relation("PerformanceReviewWorkflowTemplate", fields: [reviewWorkflowTemplateId], references: [id], onDelete: SetNull)
  approvalWorkflowTemplate              WorkflowTemplate?                      @relation("PerformanceApprovalWorkflowTemplate", fields: [approvalWorkflowTemplateId], references: [id], onDelete: SetNull)
  gradeRule                             PerformanceGradeRule?                  @relation(fields: [gradeRuleId], references: [id], onDelete: SetNull)
  periods                               PerformancePeriod[]
  planningAssignments                   PerformancePlanningAssignment[]
  performanceResults                    PerformanceResult[]
  performanceCalibrationSessions        PerformanceCalibrationSession[]
  performanceDevelopmentRecommendations PerformanceDevelopmentRecommendation[]
  performanceAutomationSchedules        PerformanceAutomationSchedule[]

  @@unique([methodId, versionNumber])
  @@index([companyId, status])
  @@index([methodId, status])
  @@index([reviewWorkflowTemplateId])
  @@index([approvalWorkflowTemplateId])
  @@map("performance_method_versions")
}

/// Formula definition used by indicator library
model PerformanceFormula {
  id                String                     @id @default(uuid()) @db.VarChar(36)
  companyId         String                     @map("company_id") @db.VarChar(36)
  name              String                     @db.VarChar(255)
  code              String                     @db.VarChar(50)
  description       String?                    @db.Text
  strategy          PerformanceFormulaStrategy
  expression        String?                    @db.Text
  roundingMode      PerformanceRoundingMode    @default(ROUND) @map("rounding_mode")
  roundingPrecision Int                        @default(2) @map("rounding_precision")
  minimumScore      Decimal?                   @map("minimum_score") @db.Decimal(5, 2)
  maximumScore      Decimal?                   @map("maximum_score") @db.Decimal(5, 2)
  isActive          Boolean                    @default(true) @map("is_active")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")
  deletedAt         DateTime?                  @map("deleted_at")

  company         Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  indicators      PerformanceIndicator[]
  planningTargets PerformancePlanningTarget[]

  @@unique([companyId, code])
  @@index([companyId, strategy, isActive])
  @@map("performance_formulas")
}

/// Reusable indicator library for performance components
model PerformanceIndicator {
  id               String                     @id @default(uuid()) @db.VarChar(36)
  companyId        String                     @map("company_id") @db.VarChar(36)
  formulaId        String?                    @map("formula_id") @db.VarChar(36)
  name             String                     @db.VarChar(255)
  code             String                     @db.VarChar(50)
  description      String?                    @db.Text
  category         String?                    @db.VarChar(100)
  perspective      String?                    @db.VarChar(100)
  measurementType  PerformanceMeasurementType @map("measurement_type")
  targetType       PerformanceTargetType      @map("target_type")
  direction        PerformanceDirection
  unit             String?                    @db.VarChar(50)
  defaultWeight    Decimal?                   @default(0) @map("default_weight") @db.Decimal(5, 2)
  minimumValue     Decimal?                   @map("minimum_value") @db.Decimal(12, 2)
  maximumValue     Decimal?                   @map("maximum_value") @db.Decimal(12, 2)
  evidenceRequired Boolean                    @default(false) @map("evidence_required")
  reviewRequired   Boolean                    @default(false) @map("review_required")
  isActive         Boolean                    @default(true) @map("is_active")
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")
  deletedAt        DateTime?                  @map("deleted_at")

  company         Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  formula         PerformanceFormula?         @relation(fields: [formulaId], references: [id], onDelete: SetNull)
  planningTargets PerformancePlanningTarget[]

  @@unique([companyId, code])
  @@index([companyId, category, isActive])
  @@index([formulaId])
  @@map("performance_indicators")
}

/// Weighted section/component definition inside a method version
model PerformanceComponent {
  id              String                   @id @default(uuid()) @db.VarChar(36)
  methodVersionId String                   @map("method_version_id") @db.VarChar(36)
  companyId       String                   @map("company_id") @db.VarChar(36)
  name            String                   @db.VarChar(255)
  code            String                   @db.VarChar(50)
  type            PerformanceComponentType @default(CUSTOM)
  description     String?                  @db.Text
  weight          Decimal                  @db.Decimal(5, 2)
  sortOrder       Int                      @default(0) @map("sort_order")
  isRequired      Boolean                  @default(true) @map("is_required")
  config          Json?
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  methodVersion   PerformanceMethodVersion    @relation(fields: [methodVersionId], references: [id], onDelete: Cascade)
  company         Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  planningTargets PerformancePlanningTarget[]

  @@unique([methodVersionId, code])
  @@index([companyId, type])
  @@index([methodVersionId, sortOrder])
  @@map("performance_components")
}

/// Grade rule set used by performance method versions
model PerformanceGradeRule {
  id                  String    @id @default(uuid()) @db.VarChar(36)
  companyId           String    @map("company_id") @db.VarChar(36)
  name                String    @db.VarChar(255)
  code                String    @db.VarChar(50)
  description         String?   @db.Text
  recommendationRules Json?     @map("recommendation_rules")
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  company        Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  ranges         PerformanceGradeRange[]
  methodVersions PerformanceMethodVersion[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("performance_grade_rules")
}

/// Grade ranges inside a rule set
model PerformanceGradeRange {
  id          String   @id @default(uuid()) @db.VarChar(36)
  gradeRuleId String   @map("grade_rule_id") @db.VarChar(36)
  label       String   @db.VarChar(50)
  minimum     Decimal  @db.Decimal(5, 2)
  maximum     Decimal  @db.Decimal(5, 2)
  sortOrder   Int      @default(0) @map("sort_order")
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  gradeRule PerformanceGradeRule @relation(fields: [gradeRuleId], references: [id], onDelete: Cascade)

  @@index([gradeRuleId, sortOrder])
  @@map("performance_grade_ranges")
}

/// Review period configuration that binds a published method version
model PerformancePeriod {
  id                  String                  @id @default(uuid()) @db.VarChar(36)
  companyId           String                  @map("company_id") @db.VarChar(36)
  methodId            String                  @map("method_id") @db.VarChar(36)
  methodVersionId     String                  @map("method_version_id") @db.VarChar(36)
  name                String                  @db.VarChar(255)
  code                String                  @db.VarChar(50)
  startDate           DateTime                @map("start_date")
  endDate             DateTime                @map("end_date")
  reviewDeadline      DateTime?               @map("review_deadline")
  status              PerformancePeriodStatus @default(DRAFT)
  description         String?                 @db.Text
  readinessSummary    Json?                   @map("readiness_summary")
  configSnapshot      Json?                   @map("config_snapshot")
  planningSummary     Json?                   @map("planning_summary")
  publishedAt         DateTime?               @map("published_at")
  planningPublishedAt DateTime?               @map("planning_published_at")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  deletedAt           DateTime?               @map("deleted_at")

  company                              Company                                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  method                               PerformanceMethod                      @relation(fields: [methodId], references: [id], onDelete: Restrict)
  methodVersion                        PerformanceMethodVersion               @relation(fields: [methodVersionId], references: [id], onDelete: Restrict)
  planningAssignments                  PerformancePlanningAssignment[]
  performanceResults                   PerformanceResult[]
  performanceCalibrationSessions       PerformanceCalibrationSession[]
  PerformanceDevelopmentRecommendation PerformanceDevelopmentRecommendation[]
  PerformanceAutomationSchedule        PerformanceAutomationSchedule[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([methodId])
  @@index([methodVersionId])
  @@map("performance_periods")
}

model PerformancePlanningAssignment {
  id                 String                              @id @default(uuid()) @db.VarChar(36)
  companyId          String                              @map("company_id") @db.VarChar(36)
  periodId           String                              @map("period_id") @db.VarChar(36)
  methodId           String                              @map("method_id") @db.VarChar(36)
  methodVersionId    String                              @map("method_version_id") @db.VarChar(36)
  employeeId         String                              @map("employee_id") @db.VarChar(36)
  reviewerId         String?                             @map("reviewer_id") @db.VarChar(36)
  approverId         String?                             @map("approver_id") @db.VarChar(36)
  assignmentSource   PerformanceAssignmentSource         @default(MANUAL) @map("assignment_source")
  status             PerformancePlanningAssignmentStatus @default(DRAFT)
  reassignmentReason String?                             @map("reassignment_reason") @db.Text
  submissionNotes    String?                             @map("submission_notes") @db.Text
  decisionNotes      String?                             @map("decision_notes") @db.Text
  employeeSnapshot   Json?                               @map("employee_snapshot")
  orgSnapshot        Json?                               @map("org_snapshot")
  planningSnapshot   Json?                               @map("planning_snapshot")
  executionSnapshot  Json?                               @map("execution_snapshot")
  publishedAt        DateTime?                           @map("published_at")
  submittedAt        DateTime?                           @map("submitted_at")
  reviewedAt         DateTime?                           @map("reviewed_at")
  completedAt        DateTime?                           @map("completed_at")
  createdAt          DateTime                            @default(now()) @map("created_at")
  updatedAt          DateTime                            @updatedAt @map("updated_at")
  deletedAt          DateTime?                           @map("deleted_at")

  company       Company                             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  period        PerformancePeriod                   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  method        PerformanceMethod                   @relation(fields: [methodId], references: [id], onDelete: Restrict)
  methodVersion PerformanceMethodVersion            @relation(fields: [methodVersionId], references: [id], onDelete: Restrict)
  employee      Employee                            @relation("PerformancePlanningEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  reviewer      Employee?                           @relation("PerformancePlanningReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  approver      Employee?                           @relation("PerformancePlanningApprover", fields: [approverId], references: [id], onDelete: SetNull)
  targets       PerformancePlanningTarget[]
  progressLogs  PerformancePlanningTargetProgress[]
  evidences     PerformancePlanningEvidence[]
  result        PerformanceResult?

  @@unique([periodId, employeeId])
  @@index([companyId, periodId, status])
  @@index([employeeId])
  @@index([reviewerId])
  @@index([approverId])
  @@index([methodVersionId])
  @@map("performance_planning_assignments")
}

model PerformancePlanningTarget {
  id               String                          @id @default(uuid()) @db.VarChar(36)
  companyId        String                          @map("company_id") @db.VarChar(36)
  assignmentId     String                          @map("assignment_id") @db.VarChar(36)
  componentId      String?                         @map("component_id") @db.VarChar(36)
  indicatorId      String?                         @map("indicator_id") @db.VarChar(36)
  formulaId        String?                         @map("formula_id") @db.VarChar(36)
  reviewerId       String?                         @map("reviewer_id") @db.VarChar(36)
  approverId       String?                         @map("approver_id") @db.VarChar(36)
  name             String                          @db.VarChar(255)
  description      String?                         @db.Text
  targetValue      Decimal?                        @map("target_value") @db.Decimal(12, 2)
  targetText       String?                         @map("target_text") @db.Text
  currentValue     Decimal?                        @map("current_value") @db.Decimal(12, 2)
  currentText      String?                         @map("current_text") @db.Text
  progressPercent  Int                             @default(0) @map("progress_percent")
  weight           Decimal                         @db.Decimal(5, 2)
  frequency        PerformanceTargetFrequency      @default(ONCE)
  evidenceRequired Boolean                         @default(false) @map("evidence_required")
  status           PerformancePlanningTargetStatus @default(DRAFT)
  config           Json?
  selfComment      String?                         @map("self_comment") @db.Text
  reviewerComment  String?                         @map("reviewer_comment") @db.Text
  submittedAt      DateTime?                       @map("submitted_at")
  reviewedAt       DateTime?                       @map("reviewed_at")
  completedAt      DateTime?                       @map("completed_at")
  createdAt        DateTime                        @default(now()) @map("created_at")
  updatedAt        DateTime                        @updatedAt @map("updated_at")
  deletedAt        DateTime?                       @map("deleted_at")

  company      Company                             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assignment   PerformancePlanningAssignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  component    PerformanceComponent?               @relation(fields: [componentId], references: [id], onDelete: SetNull)
  indicator    PerformanceIndicator?               @relation(fields: [indicatorId], references: [id], onDelete: SetNull)
  formula      PerformanceFormula?                 @relation(fields: [formulaId], references: [id], onDelete: SetNull)
  reviewer     Employee?                           @relation("PerformancePlanningTargetReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  approver     Employee?                           @relation("PerformancePlanningTargetApprover", fields: [approverId], references: [id], onDelete: SetNull)
  progressLogs PerformancePlanningTargetProgress[]
  evidences    PerformancePlanningEvidence[]

  @@index([companyId, assignmentId, status])
  @@index([componentId])
  @@index([indicatorId])
  @@index([formulaId])
  @@index([reviewerId])
  @@index([approverId])
  @@map("performance_planning_targets")
}

model PerformancePlanningTargetProgress {
  id              String   @id @default(uuid()) @db.VarChar(36)
  companyId       String   @map("company_id") @db.VarChar(36)
  assignmentId    String   @map("assignment_id") @db.VarChar(36)
  targetId        String   @map("target_id") @db.VarChar(36)
  actorId         String?  @map("actor_id") @db.VarChar(36)
  progressPercent Int      @default(0) @map("progress_percent")
  currentValue    Decimal? @map("current_value") @db.Decimal(12, 2)
  currentText     String?  @map("current_text") @db.Text
  note            String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  company    Company                       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assignment PerformancePlanningAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  target     PerformancePlanningTarget     @relation(fields: [targetId], references: [id], onDelete: Cascade)
  actor      Employee?                     @relation("PerformancePlanningProgressActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, assignmentId])
  @@index([targetId])
  @@index([actorId])
  @@map("performance_planning_target_progresses")
}

model PerformancePlanningEvidence {
  id           String   @id @default(uuid()) @db.VarChar(36)
  companyId    String   @map("company_id") @db.VarChar(36)
  assignmentId String   @map("assignment_id") @db.VarChar(36)
  targetId     String   @map("target_id") @db.VarChar(36)
  uploadedById String?  @map("uploaded_by_id") @db.VarChar(36)
  fileName     String   @map("file_name") @db.VarChar(255)
  originalName String   @map("original_name") @db.VarChar(255)
  fileUrl      String   @map("file_url") @db.VarChar(500)
  mimeType     String   @map("mime_type") @db.VarChar(100)
  fileSize     Int      @map("file_size")
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  company    Company                       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assignment PerformancePlanningAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  target     PerformancePlanningTarget     @relation(fields: [targetId], references: [id], onDelete: Cascade)
  uploadedBy Employee?                     @relation("PerformancePlanningEvidenceUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([companyId, assignmentId])
  @@index([targetId])
