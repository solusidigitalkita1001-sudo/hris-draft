  performanceDevelopmentRecommendations PerformanceDevelopmentRecommendation[]

  @@index([categoryId])
  @@index([companyId])
  @@index([code])
  @@map("training_courses")
}

/// Training session (scheduled instance of a course)
model TrainingSession {
  id              String        @id @default(uuid()) @db.VarChar(36)
  courseId        String        @map("course_id") @db.VarChar(36)
  trainer         String?       @db.VarChar(255)
  location        String?       @db.VarChar(255)
  startDate       DateTime      @map("start_date")
  endDate         DateTime?     @map("end_date")
  maxParticipants Int?          @default(0) @map("max_participants")
  status          SessionStatus @default(SCHEDULED)
  notes           String?       @db.Text
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")

  course      TrainingCourse       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  attendances TrainingAttendance[]

  @@index([courseId])
  @@index([status])
  @@map("training_sessions")
}

/// Training material (file, link)
model TrainingMaterial {
  id        String   @id @default(uuid()) @db.VarChar(36)
  courseId  String   @map("course_id") @db.VarChar(36)
  title     String   @db.VarChar(255)
  type      String   @default("FILE") @db.VarChar(50)
  url       String?  @db.VarChar(500)
  filePath  String?  @map("file_path") @db.VarChar(500)
  fileSize  Int?     @map("file_size")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  course TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("training_materials")
}

/// Employee enrollment in a training course
model TrainingEnrollment {
  id          String           @id @default(uuid()) @db.VarChar(36)
  courseId    String           @map("course_id") @db.VarChar(36)
  employeeId  String           @map("employee_id") @db.VarChar(36)
  companyId   String           @map("company_id") @db.VarChar(36)
  status      EnrollmentStatus @default(ENROLLED)
  progress    Int              @default(0)
  completedAt DateTime?        @map("completed_at")
  score       Decimal?         @db.Decimal(5, 2)
  notes       String?          @db.Text
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")

  course                                TrainingCourse                         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  employee                              Employee                               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  company                               Company                                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  performanceDevelopmentRecommendations PerformanceDevelopmentRecommendation[]

  @@index([courseId])
  @@index([employeeId])
  @@index([companyId])
  @@index([status])
  @@map("training_enrollments")
}

/// Training attendance record
model TrainingAttendance {
  id         String           @id @default(uuid()) @db.VarChar(36)
  sessionId  String           @map("session_id") @db.VarChar(36)
  employeeId String           @map("employee_id") @db.VarChar(36)
  status     AttendanceStatus @default(PRESENT)
  checkIn    DateTime?        @map("check_in")
  checkOut   DateTime?        @map("check_out")
  notes      String?          @db.Text
  createdAt  DateTime         @default(now()) @map("created_at")

  session  TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([sessionId, employeeId])
  @@map("training_attendances")
}

// ============================================================
// RECRUITMENT
// ============================================================

/// Job posting / requisition
model JobPosting {
  id               String        @id @default(uuid()) @db.VarChar(36)
  companyId        String        @map("company_id") @db.VarChar(36)
  departmentId     String?       @map("department_id") @db.VarChar(36)
  positionId       String?       @map("position_id") @db.VarChar(36)
  title            String        @db.VarChar(255)
  code             String        @unique @db.VarChar(50)
  employmentType   String        @default("FULL_TIME") @map("employment_type") @db.VarChar(50)
  location         String?       @db.VarChar(255)
  minSalary        Decimal?      @map("min_salary") @db.Decimal(15, 2)
  maxSalary        Decimal?      @map("max_salary") @db.Decimal(15, 2)
  currency         String        @default("IDR") @db.VarChar(10)
  description      String?       @db.Text
  requirements     String?       @db.Text
  responsibilities String?       @db.Text
  vacancies        Int           @default(1)
  status           PostingStatus @default(DRAFT)
  postedAt         DateTime?     @map("posted_at")
  closedAt         DateTime?     @map("closed_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  department   Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position     Position?        @relation(fields: [positionId], references: [id], onDelete: SetNull)
  applications JobApplication[]

  @@index([companyId])
  @@index([code])
  @@index([status])
  @@map("job_postings")
}

/// Candidate
model Candidate {
  id              String          @id @default(uuid()) @db.VarChar(36)
  companyId       String          @map("company_id") @db.VarChar(36)
  firstName       String          @map("first_name") @db.VarChar(255)
  lastName        String          @map("last_name") @db.VarChar(255)
  email           String?         @db.VarChar(255)
  phone           String?         @db.VarChar(50)
  currentCompany  String?         @map("current_company") @db.VarChar(255)
  currentPosition String?         @map("current_position") @db.VarChar(255)
  resume          String?         @db.VarChar(500)
  portfolio       String?         @db.VarChar(500)
  source          String?         @db.VarChar(100)
  notes           String?         @db.Text
  status          CandidateStatus @default(ACTIVE)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  applications JobApplication[]
  interviews   Interview[]

  @@index([companyId])
  @@index([email])
  @@index([status])
  @@map("candidates")
}

/// Job application (links candidate to job posting)
model JobApplication {
  id             String            @id @default(uuid()) @db.VarChar(36)
  jobPostingId   String            @map("job_posting_id") @db.VarChar(36)
  candidateId    String            @map("candidate_id") @db.VarChar(36)
  companyId      String            @map("company_id") @db.VarChar(36)
  status         ApplicationStatus @default(NEW)
  coverLetter    String?           @map("cover_letter") @db.Text
  expectedSalary Decimal?          @map("expected_salary") @db.Decimal(15, 2)
  notes          String?           @db.Text
  appliedAt      DateTime          @default(now()) @map("applied_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")

  jobPosting JobPosting  @relation(fields: [jobPostingId], references: [id], onDelete: Restrict)
  candidate  Candidate   @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  interviews Interview[]

  @@index([jobPostingId])
  @@index([candidateId])
  @@index([companyId])
  @@index([status])
  @@map("job_applications")
}

/// Interview
model Interview {
  id              String          @id @default(uuid()) @db.VarChar(36)
  applicationId   String          @map("application_id") @db.VarChar(36)
  candidateId     String          @map("candidate_id") @db.VarChar(36)
  interviewerId   String?         @map("interviewer_id") @db.VarChar(36)
  companyId       String          @map("company_id") @db.VarChar(36)
  type            String          @default("ONLINE") @db.VarChar(50)
  title           String          @db.VarChar(255)
  scheduledAt     DateTime        @map("scheduled_at")
  durationMinutes Int?            @default(60) @map("duration_minutes")
  location        String?         @db.VarChar(255)
  meetingLink     String?         @map("meeting_link") @db.VarChar(500)
  status          InterviewStatus @default(SCHEDULED)
  notes           String?         @db.Text
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")

  application JobApplication      @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  candidate   Candidate           @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  feedback    InterviewFeedback[]

  @@index([applicationId])
  @@index([candidateId])
  @@index([interviewerId])
  @@index([status])
  @@map("interviews")
}

/// Interview feedback
model InterviewFeedback {
  id          String   @id @default(uuid()) @db.VarChar(36)
  interviewId String   @map("interview_id") @db.VarChar(36)
  rating      Int?     @default(0)
  strengths   String?  @db.Text
  weaknesses  String?  @db.Text
  decision    String?  @db.VarChar(50)
  notes       String?  @db.Text
  submittedAt DateTime @default(now()) @map("submitted_at")
  createdAt   DateTime @default(now()) @map("created_at")

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
  @@map("interview_feedback")
}

// ============================================================
// WORK CALENDAR
// ============================================================

/// Calendar definition (per company, branch, or department)
model WorkCalendar {
  id           String    @id @default(uuid()) @db.VarChar(36)
  companyId    String    @map("company_id") @db.VarChar(36)
  branchId     String?   @map("branch_id") @db.VarChar(36)
  departmentId String?   @map("department_id") @db.VarChar(36)
  name         String    @db.VarChar(100)
  year         Int
  workDays     Json      @map("work_days")
  isActive     Boolean   @default(true) @map("is_active")
  description  String?   @db.Text
  createdBy    String    @map("created_by") @db.VarChar(36)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  company Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  days    WorkCalendarDay[]

  @@unique([companyId, branchId, departmentId, year])
  @@index([companyId])
  @@index([year])
  @@map("work_calendars")
}

/// Individual day entries (only days that differ from defaults)
model WorkCalendarDay {
  id          String   @id @default(uuid()) @db.VarChar(36)
  calendarId  String   @map("calendar_id") @db.VarChar(36)
  date        DateTime @db.Date
  dayType     String   @map("day_type") @db.VarChar(2)
  name        String?  @db.VarChar(150)
  notes       String?  @db.Text
  workStart   String?  @map("work_start") @db.VarChar(5)
  workEnd     String?  @map("work_end") @db.VarChar(5)
  isMandatory Boolean  @default(false) @map("is_mandatory")
  createdAt   DateTime @default(now()) @map("created_at")

  calendar WorkCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, date])
  @@index([calendarId])
  @@index([date])
  @@map("work_calendar_days")
}

/// Master national holidays reference
model NationalHoliday {
  id          String   @id @default(uuid()) @db.VarChar(36)
  companyId   String   @map("company_id") @db.VarChar(36)
  countryCode String   @default("ID") @map("country_code") @db.VarChar(2)
  date        DateTime @db.Date
  name        String   @db.VarChar(150)
  type        String   @db.VarChar(2)
  year        Int
  source      String?  @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, countryCode, date])
  @@index([year])
  @@map("national_holidays")
}

model ShiftFormula {
  id          String    @id @default(uuid()) @db.VarChar(36)
  companyId   String    @map("company_id") @db.VarChar(36)
  code        String    @db.VarChar(50)
  name        String    @db.VarChar(150)
  cycleLength Int       @map("cycle_length")
  description String?   @db.Text
  createdBy   String?   @map("created_by") @db.VarChar(36)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  days      ShiftFormulaDay[]
  employees Employee[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("shift_formulas")
}

model ShiftFormulaDay {
  id              String   @id @default(uuid()) @db.VarChar(36)
  shiftFormulaId  String   @map("shift_formula_id") @db.VarChar(36)
  sequence        Int
  label           String?  @db.VarChar(100)
  dayType         String   @map("day_type") @db.VarChar(2)
  workStart       String?  @map("work_start") @db.VarChar(5)
  workEnd         String?  @map("work_end") @db.VarChar(5)
  crossesMidnight Boolean  @default(false) @map("crosses_midnight")
  createdAt       DateTime @default(now()) @map("created_at")

  shiftFormula ShiftFormula @relation(fields: [shiftFormulaId], references: [id], onDelete: Cascade)

  @@unique([shiftFormulaId, sequence])
  @@index([shiftFormulaId])
  @@map("shift_formula_days")
}

model ShiftSwapRequest {
  id                  String        @id @default(uuid()) @db.VarChar(36)
  companyId           String        @map("company_id") @db.VarChar(36)
  requesterEmployeeId String        @map("requester_employee_id") @db.VarChar(36)
  targetEmployeeId    String        @map("target_employee_id") @db.VarChar(36)
  approverEmployeeId  String        @map("approver_employee_id") @db.VarChar(36)
  shiftDate           DateTime      @map("shift_date") @db.Date
  reason              String        @db.Text
  status              RequestStatus @default(PENDING)
  approvalNotes       String?       @map("approval_notes") @db.Text
  reviewedAt          DateTime?     @map("reviewed_at")
  cancelledAt         DateTime?     @map("cancelled_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  deletedAt           DateTime?     @map("deleted_at")

  company           Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requesterEmployee Employee                @relation("ShiftSwapRequester", fields: [requesterEmployeeId], references: [id], onDelete: Cascade)
  targetEmployee    Employee                @relation("ShiftSwapTarget", fields: [targetEmployeeId], references: [id], onDelete: Cascade)
  approverEmployee  Employee                @relation("ShiftSwapApprover", fields: [approverEmployeeId], references: [id], onDelete: Restrict)
  overrides         EmployeeShiftOverride[]

  @@index([companyId, status])
  @@index([requesterEmployeeId, status])
  @@index([targetEmployeeId, status])
  @@index([approverEmployeeId, status])
  @@index([shiftDate])
  @@map("shift_swap_requests")
}

model EmployeeShiftOverride {
  id                 String    @id @default(uuid()) @db.VarChar(36)
  companyId          String    @map("company_id") @db.VarChar(36)
  employeeId         String    @map("employee_id") @db.VarChar(36)
  shiftSwapRequestId String?   @map("shift_swap_request_id") @db.VarChar(36)
  date               DateTime  @db.Date
  source             String    @default("SHIFT_SWAP") @db.VarChar(50)
  originalSchedule   Json      @map("original_schedule")
  overrideSchedule   Json      @map("override_schedule")
  notes              String?   @db.Text
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee         Employee          @relation("EmployeeShiftOverrides", fields: [employeeId], references: [id], onDelete: Cascade)
  shiftSwapRequest ShiftSwapRequest? @relation(fields: [shiftSwapRequestId], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@index([companyId, date])
  @@index([employeeId, date])
  @@index([shiftSwapRequestId])
  @@map("employee_shift_overrides")
}

// ============================================================
// AUTHENTICATION & AUTHORIZATION
// ============================================================

/// Users (login accounts)
model User {
  id                 String     @id @default(uuid()) @db.VarChar(36)
  email              String     @unique @db.VarChar(255)
  passwordHash       String     @map("password_hash") @db.VarChar(255)
  passwordVersion    Int        @default(1) @map("password_version")
  employeeId         String?    @unique @map("employee_id") @db.VarChar(36)
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(true) @map("must_change_password")
  lastLoginAt        DateTime?  @map("last_login_at")
  failedAttempts     Int        @default(0) @map("failed_attempts")
  lockedUntil        DateTime?  @map("locked_until")
  twoFactorEnabled   Boolean    @default(false) @map("two_factor_enabled")
  twoFactorSecret    String?    @map("two_factor_secret") @db.VarChar(255)
  twoFactorRecoveryCodes String? @map("two_factor_recovery_codes") @db.Text
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  deletedAt          DateTime?  @map("deleted_at")

  employee                   Employee?                   @relation("EmployeeUser", fields: [employeeId], references: [id], onDelete: SetNull)
  userRoles                  UserRole[]
  refreshTokens              RefreshToken[]
  loginLogs                  LoginLog[]
  loginAttempts              LoginAttempt[]
  auditLogs                  AuditLog[]
  notifications              Notification[]
  uploadedDocuments          Document[]                  @relation("DocumentUploader")
  documentSignatures         DocumentSignature[]
  documentAccessLogs         DocumentAccessLog[]
  createdCareerTransactions  EmployeeCareerTransaction[]
  companyAccesses            UserCompanyAccess[]
  approvedCompanyAssignments EmployeeCompanyAssignment[]
  /// D.1 Announcements (pengumuman yang dibuat user sebagai HR/ADMIN)
  announcementsCreated         Announcement[]
  /// D.1 Read status pengumuman per user
  announcementReads            AnnouncementRead[]
  /// D.2 Surveys yang dibuat user (HR/ADMIN)
  surveysCreated               Survey[]
  /// D.2 Survey responses sebagai responden (bisa null jika anonymous)
  surveyResponses              SurveyResponse[]
  /// D.3 E-Signature: dokumen user sebagai signer (wrapper transaction)
  esignatureAsSigner        ESignatureTransaction[]

  @@index([email])
  @@index([status])
  @@map("users")
}

/// Employee master data
model Employee {
  id                  String           @id @default(uuid()) @db.VarChar(36)
  companyId           String           @map("company_id") @db.VarChar(36)
  branchId            String?          @map("branch_id") @db.VarChar(36)
  departmentId        String?          @map("department_id") @db.VarChar(36)
  subDepartmentId     String?          @map("sub_department_id") @db.VarChar(36)
  positionId          String?          @map("position_id") @db.VarChar(36)
  shiftFormulaId      String?          @map("shift_formula_id") @db.VarChar(36)
  employeeNumber      String           @unique @map("employee_number") @db.VarChar(50)
  firstName           String           @map("first_name") @db.VarChar(255)
  lastName            String           @map("last_name") @db.VarChar(255)
  fullName            String           @map("full_name") @db.VarChar(510)
  email               String?          @unique @db.VarChar(255)
  phone               String?          @db.VarChar(50)
  idNumber            String?          @map("id_number") @db.VarChar(50)
  placeOfBirth        String?          @map("place_of_birth") @db.VarChar(255)
  dateOfBirth         DateTime?        @map("date_of_birth")
  gender              Gender?
  religion            Religion?
  maritalStatus       MaritalStatus?   @map("marital_status")
  bloodType           BloodType?       @map("blood_type")
  nationality         String?          @default("Indonesia") @db.VarChar(50)
  address             String?          @db.Text
  avatar              String?          @db.VarChar(500)
  /// B.7 Backend Ready Face Rec: Reference foto selfie untuk match saat clock in (onboarding saat upload 1 foto pertama). Bisa beda avatar (avatar foto formal, reference foto selfie natural).
  referencePhotoUrl   String?          @map("reference_photo_url") @db.VarChar(500)
  referencePhotoUpdatedAt DateTime?    @map("reference_photo_updated_at")
  joinDate            DateTime?        @map("join_date")
  employmentStatus    EmploymentStatus @default(ACTIVE) @map("employment_status")
  employmentType      EmploymentType   @default(PERMANENT) @map("employment_type")
  employeeCategory    EmployeeCategory @default(OFFICE) @map("employee_category")
  shiftStartDate      DateTime?        @map("shift_start_date") @db.Date
  bankName            String?          @map("bank_name") @db.VarChar(100)
  bankCode            String?          @map("bank_code") @db.VarChar(20)
  bankAccount         String?          @map("bank_account") @db.VarChar(50)
  bankAccountHolder   String?          @map("bank_account_holder") @db.VarChar(255)
  taxId               String?          @map("tax_id") @db.VarChar(50)
  bpjsKetenagakerjaan String?          @map("bpjs_ketenagakerjaan") @db.VarChar(50)
  bpjsKesehatan       String?          @map("bpjs_kesehatan") @db.VarChar(50)
  status              Status           @default(ACTIVE)
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  deletedAt           DateTime?        @map("deleted_at")

  company                                       Company                                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch                                        Branch?                                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department                                    Department?                            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  subDepartment                                 SubDepartment?                         @relation(fields: [subDepartmentId], references: [id], onDelete: SetNull)
  position                                      Position?                              @relation(fields: [positionId], references: [id], onDelete: SetNull)
  shiftFormula                                  ShiftFormula?                          @relation(fields: [shiftFormulaId], references: [id], onDelete: SetNull)
  user                                          User?                                  @relation("EmployeeUser")
  divisionHeads                                 Division[]                             @relation("DivisionHead")
  departmentHeads                               Department[]                           @relation("DepartmentHead")
  subDepartmentHeads                            SubDepartment[]                        @relation("SubDepartmentHead")
  employeeSalaries                              EmployeeSalary[]
  payslips                                      Payslip[]
  benefitEnrollments                            BenefitEnrollment[]
  performanceReviewsAsEmployee                  PerformanceReview[]                    @relation("ReviewEmployee")
  performanceReviewsAsReviewer                  PerformanceReview[]                    @relation("ReviewReviewer")
  performancePlanningAssignmentsAsEmployee      PerformancePlanningAssignment[]        @relation("PerformancePlanningEmployee")
  performancePlanningAssignmentsAsReviewer      PerformancePlanningAssignment[]        @relation("PerformancePlanningReviewer")
  performancePlanningAssignmentsAsApprover      PerformancePlanningAssignment[]        @relation("PerformancePlanningApprover")
  performancePlanningTargetsAsReviewer          PerformancePlanningTarget[]            @relation("PerformancePlanningTargetReviewer")
  performancePlanningTargetsAsApprover          PerformancePlanningTarget[]            @relation("PerformancePlanningTargetApprover")
  performancePlanningTargetProgresses           PerformancePlanningTargetProgress[]    @relation("PerformancePlanningProgressActor")
  performancePlanningEvidences                  PerformancePlanningEvidence[]          @relation("PerformancePlanningEvidenceUploader")
  performanceResultsAsEmployee                  PerformanceResult[]                    @relation("PerformanceResultEmployee")
  performanceResultsAsReviewer                  PerformanceResult[]                    @relation("PerformanceResultReviewer")
  performanceResultsAsApprover                  PerformanceResult[]                    @relation("PerformanceResultApprover")
  performanceResultsAsOverrideActor             PerformanceResult[]                    @relation("PerformanceResultOverrideActor")
  performanceResultsAsPublisher                 PerformanceResult[]                    @relation("PerformanceResultPublisher")
  performanceResultsAsFinalApprover             PerformanceResult[]                    @relation("PerformanceResultFinalApprover")
  performanceResultsAsReopenActor               PerformanceResult[]                    @relation("PerformanceResultReopenActor")
  performanceCalibrationSessionsCreated         PerformanceCalibrationSession[]        @relation("PerformanceCalibrationSessionCreator")
  performanceCalibrationDecisionsChanged        PerformanceCalibrationDecision[]       @relation("PerformanceCalibrationDecisionActor")
  performanceResultDisputesAsEmployee           PerformanceResultDispute[]             @relation("PerformanceResultDisputeEmployee")
  performanceResultDisputesAsResponder          PerformanceResultDispute[]             @relation("PerformanceResultDisputeResponder")
  performanceDevelopmentRecommendations         PerformanceDevelopmentRecommendation[] @relation("PerformanceDevelopmentEmployee")
