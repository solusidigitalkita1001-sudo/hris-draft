/// Daily attendance record
model Attendance {
  id              String            @id @default(uuid()) @db.VarChar(36)
  employeeId      String            @map("employee_id") @db.VarChar(36)
  companyId       String            @map("company_id") @db.VarChar(36)
  date            DateTime          @map("date") @db.Date
  checkIn         DateTime?         @map("check_in")
  checkOut        DateTime?         @map("check_out")
  status          AttendanceStatus  @default(PRESENT)
  workDuration    Int?              @default(0) @map("work_duration")
  lateMinutes     Int?              @default(0) @map("late_minutes")
  earlyLeaveMinutes Int?            @default(0) @map("early_leave_minutes")
  notes           String?           @db.Text
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([employeeId, date])
  @@index([companyId])
  @@index([date])
  @@index([employeeId])
  @@index([status])
  @@map("attendances")
}

/// Overtime request
model OvertimeRequest {
  id              String            @id @default(uuid()) @db.VarChar(36)
  employeeId      String            @map("employee_id") @db.VarChar(36)
  companyId       String            @map("company_id") @db.VarChar(36)
  date            DateTime          @map("date") @db.Date
  startTime       DateTime          @map("start_time")
  endTime         DateTime          @map("end_time")
  durationHours   Decimal           @map("duration_hours") @db.Decimal(5, 2)
  reason          String            @db.Text
  multiplier      Decimal           @default(1.5) @db.Decimal(3, 1)
  status          OvertimeStatus    @default(PENDING)
  approvedBy      String?           @map("approved_by") @db.VarChar(36)
  approvedAt      DateTime?         @map("approved_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([companyId])
  @@index([status])
  @@index([date])
  @@map("overtime_requests")
}

