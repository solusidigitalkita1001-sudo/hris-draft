// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// COMPANY GROUP STRUCTURE
// ============================================================

/// Holding company / parent organization
model CompanyGroup {
  id        String   @id @default(uuid()) @db.VarChar(36)
  name      String   @db.VarChar(255)
  code      String   @unique @db.VarChar(50)
  taxId     String?  @map("tax_id") @db.VarChar(50)
  address   String?  @db.Text
  phone     String?  @db.VarChar(50)
  email     String?  @db.VarChar(255)
  logo      String?  @db.VarChar(500)
  website   String?  @db.VarChar(500)
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  companies     Company[]
  groupPolicies GroupPolicy[]
  groupSettings GroupSetting[]
  roles         Role[]

  @@map("company_groups")
}

/// Company entity under a group
model Company {
  id             String   @id @default(uuid()) @db.VarChar(36)
  groupId        String   @map("group_id") @db.VarChar(36)
  name           String   @db.VarChar(255)
  code           String   @unique @db.VarChar(50)
  taxId          String?  @map("tax_id") @db.VarChar(50)
  address        String?  @db.Text
  phone          String?  @db.VarChar(50)
  email          String?  @db.VarChar(255)
  logo           String?  @db.VarChar(500)
  website        String?  @db.VarChar(500)
  timezone       String   @default("Asia/Jakarta") @db.VarChar(50)
  dateFormat     String   @default("DD/MM/YYYY") @map("date_format") @db.VarChar(20)
  fiscalYearStart String  @default("01-01") @map("fiscal_year_start") @db.VarChar(5)
  currency       String   @default("IDR") @db.VarChar(10)
  status         Status   @default(ACTIVE)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  group           CompanyGroup     @relation(fields: [groupId], references: [id], onDelete: Restrict)
  branches        Branch[]
  divisions       Division[]
  departments     Department[]
  positions       Position[]
  employees       Employee[]
  roles           Role[]
  companySettings CompanySetting[]
  auditLogs       AuditLog[]

  @@index([groupId])
  @@index([code])
  @@index([status])
  @@map("companies")
}

/// Physical branch / location
model Branch {
  id        String   @id @default(uuid()) @db.VarChar(36)
  companyId String   @map("company_id") @db.VarChar(36)
  name      String   @db.VarChar(255)
  code      String   @unique @db.VarChar(50)
  address   String?  @db.Text
  phone     String?  @db.VarChar(50)
  email     String?  @db.VarChar(255)
  timezone  String   @default("Asia/Jakarta") @db.VarChar(50)
  latitude  Float?
  longitude Float?
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employees Employee[]

  @@index([companyId])
  @@index([code])
  @@map("branches")
}

/// Functional vertical division
model Division {
  id          String   @id @default(uuid()) @db.VarChar(36)
  companyId   String   @map("company_id") @db.VarChar(36)
  name        String   @db.VarChar(255)
  code        String   @unique @db.VarChar(50)
  headId      String?  @map("head_id") @db.VarChar(36)
  description String?  @db.Text
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  head        Employee?    @relation("DivisionHead", fields: [headId], references: [id], onDelete: SetNull)
  departments Department[]

  @@index([companyId])
  @@index([code])
  @@map("divisions")
}

/// Department under division
model Department {
  id          String   @id @default(uuid()) @db.VarChar(36)
  divisionId  String?  @map("division_id") @db.VarChar(36)
  companyId   String   @map("company_id") @db.VarChar(36)
  parentId    String?  @map("parent_id") @db.VarChar(36)
  name        String   @db.VarChar(255)
  code        String   @unique @db.VarChar(50)
  headId      String?  @map("head_id") @db.VarChar(36)
  description String?  @db.Text
  costCenter  String?  @map("cost_center") @db.VarChar(50)
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  division       Division?       @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parent         Department?     @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Department[]    @relation("DepartmentHierarchy")
  head           Employee?       @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  subDepartments SubDepartment[]
  positions      Position[]
  employees      Employee[]

  @@index([divisionId])
  @@index([companyId])
  @@index([parentId])
  @@index([code])
  @@map("departments")
}

/// Sub-department / team level
model SubDepartment {
  id           String   @id @default(uuid()) @db.VarChar(36)
  departmentId String   @map("department_id") @db.VarChar(36)
  name         String   @db.VarChar(255)
  code         String   @unique @db.VarChar(50)
  headId       String?  @map("head_id") @db.VarChar(36)
  description  String?  @db.Text
  status       Status   @default(ACTIVE)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  head       Employee?  @relation("SubDepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  employees  Employee[]

  @@index([departmentId])
  @@index([code])
  @@map("sub_departments")
}

/// Job position
model Position {
  id           String   @id @default(uuid()) @db.VarChar(36)
  departmentId String?  @map("department_id") @db.VarChar(36)
  companyId    String   @map("company_id") @db.VarChar(36)
  name         String   @db.VarChar(255)
  code         String   @unique @db.VarChar(50)
  gradeLevel   Int?     @map("grade_level")
  minSalary    Decimal? @map("min_salary") @db.Decimal(15, 2)
  maxSalary    Decimal? @map("max_salary") @db.Decimal(15, 2)
  reportsToId  String?  @map("reports_to_id") @db.VarChar(36)
  description  String?  @db.Text
  requirements String?  @db.Text
  status       Status   @default(ACTIVE)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  reportsTo    Position?   @relation("PositionHierarchy", fields: [reportsToId], references: [id], onDelete: SetNull)
  subordinates Position[]  @relation("PositionHierarchy")
  employees    Employee[]

  @@index([departmentId])
  @@index([companyId])
  @@index([code])
  @@map("positions")
}

// ============================================================
// AUTHENTICATION & AUTHORIZATION
// ============================================================

/// Users (login accounts)
model User {
  id                 String     @id @default(uuid()) @db.VarChar(36)
  email              String     @unique @db.VarChar(255)
  passwordHash       String     @map("password_hash") @db.VarChar(255)
  employeeId         String?    @unique @map("employee_id") @db.VarChar(36)
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(true) @map("must_change_password")
  lastLoginAt        DateTime?  @map("last_login_at")
  failedAttempts     Int        @default(0) @map("failed_attempts")
  lockedUntil        DateTime?  @map("locked_until")
  twoFactorEnabled   Boolean    @default(false) @map("two_factor_enabled")
  twoFactorSecret    String?    @map("two_factor_secret") @db.VarChar(255)
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  deletedAt          DateTime?  @map("deleted_at")

  employee        Employee?      @relation("EmployeeUser", fields: [employeeId], references: [id], onDelete: SetNull)
  userRoles       UserRole[]
  refreshTokens   RefreshToken[]
  loginLogs       LoginLog[]
  loginAttempts   LoginAttempt[]
  auditLogs       AuditLog[]

  @@index([email])
  @@index([status])
  @@map("users")
}

/// Employee master data
model Employee {
  id               String           @id @default(uuid()) @db.VarChar(36)
  companyId        String           @map("company_id") @db.VarChar(36)
  branchId         String?          @map("branch_id") @db.VarChar(36)
  departmentId     String?          @map("department_id") @db.VarChar(36)
  subDepartmentId  String?          @map("sub_department_id") @db.VarChar(36)
  positionId       String?          @map("position_id") @db.VarChar(36)
  employeeNumber   String           @unique @map("employee_number") @db.VarChar(50)
  firstName        String           @map("first_name") @db.VarChar(255)
  lastName         String           @map("last_name") @db.VarChar(255)
  fullName         String           @map("full_name") @db.VarChar(510)
  email            String?          @unique @db.VarChar(255)
  phone            String?          @db.VarChar(50)
  idNumber         String?          @map("id_number") @db.VarChar(50)
  placeOfBirth     String?          @map("place_of_birth") @db.VarChar(255)
  dateOfBirth      DateTime?        @map("date_of_birth")
  gender           String?          @db.VarChar(20)
  religion         String?          @db.VarChar(50)
  maritalStatus    String?          @map("marital_status") @db.VarChar(20)
  bloodType        String?          @map("blood_type") @db.VarChar(5)
  nationality      String?          @default("Indonesia") @db.VarChar(50)
  address          String?          @db.Text
  avatar           String?          @db.VarChar(500)
  joinDate         DateTime?        @map("join_date")
  employmentStatus EmploymentStatus @default(ACTIVE) @map("employment_status")
  employmentType   EmploymentType   @default(PERMANENT) @map("employment_type")
  status           Status           @default(ACTIVE)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  deletedAt        DateTime?        @map("deleted_at")

  company             Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch              Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department          Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  subDepartment       SubDepartment? @relation(fields: [subDepartmentId], references: [id], onDelete: SetNull)
  position            Position?      @relation(fields: [positionId], references: [id], onDelete: SetNull)
  user                User?          @relation("EmployeeUser")
  divisionHeads       Division[]     @relation("DivisionHead")
  departmentHeads     Department[]   @relation("DepartmentHead")
  subDepartmentHeads  SubDepartment[] @relation("SubDepartmentHead")

  @@index([companyId])
  @@index([employeeNumber])
  @@index([departmentId])
  @@index([positionId])
  @@index([employmentStatus])
  @@index([branchId])
  @@map("employees")
}

/// Roles
model Role {
  id          String    @id @default(uuid()) @db.VarChar(36)
  companyId   String?   @map("company_id") @db.VarChar(36)
  groupId     String?   @map("group_id") @db.VarChar(36)
  name        String    @db.VarChar(255)
  code        String    @unique @db.VarChar(50)
  description String?   @db.Text
  scope       RoleScope @default(COMPANY)
  isSystem    Boolean   @default(false) @map("is_system")
  priority    Int       @default(0)
  status      Status    @default(ACTIVE)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  company         Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  group           CompanyGroup?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@index([companyId])
  @@index([groupId])
  @@index([code])
  @@map("roles")
}

/// Permissions
model Permission {
  id          String   @id @default(uuid()) @db.VarChar(36)
  resource    String   @db.VarChar(100)
  action      String   @db.VarChar(50)
  name        String   @db.VarChar(255)
  code        String   @unique @db.VarChar(100)
  description String?  @db.Text
  module      String   @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@index([resource, action])
  @@index([module])
  @@index([code])
  @@map("permissions")
}

/// Role-Permission mapping
model RolePermission {
  roleId       String @map("role_id") @db.VarChar(36)
  permissionId String @map("permission_id") @db.VarChar(36)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// User-Role assignment
model UserRole {
  id        String    @id @default(uuid()) @db.VarChar(36)
  userId    String    @map("user_id") @db.VarChar(36)
  roleId    String    @map("role_id") @db.VarChar(36)
  companyId String?   @map("company_id") @db.VarChar(36)
  groupId   String?   @map("group_id") @db.VarChar(36)
  scopeType RoleScope @default(COMPANY) @map("scope_type")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([roleId])
  @@index([companyId])
  @@map("user_roles")
}

/// Refresh tokens (rotation support)
model RefreshToken {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  family    String   @db.VarChar(100)
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  userAgent String?  @map("user_agent") @db.VarChar(500)
  ipAddress String?  @map("ip_address") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([family])
  @@map("refresh_tokens")
}

/// Login logs
model LoginLog {
  id         String      @id @default(uuid()) @db.VarChar(36)
  userId     String?     @map("user_id") @db.VarChar(36)
  email      String      @db.VarChar(255)
  status     LoginStatus
  ipAddress  String?     @map("ip_address") @db.VarChar(50)
  userAgent  String?     @map("user_agent") @db.VarChar(500)
  failReason String?     @map("fail_reason") @db.VarChar(255)
  createdAt  DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([email])
  @@index([createdAt])
  @@map("login_logs")
}

/// Login attempt tracking
model LoginAttempt {
  id          String   @id @default(uuid()) @db.VarChar(36)
  userId      String   @map("user_id") @db.VarChar(36)
  ipAddress   String?  @map("ip_address") @db.VarChar(50)
  attemptedAt DateTime @default(now()) @map("attempted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, attemptedAt])
  @@map("login_attempts")
}

// ============================================================
// AUDIT & SETTINGS
// ============================================================

/// Audit log
model AuditLog {
  id        String   @id @default(uuid()) @db.VarChar(36)
  companyId String?  @map("company_id") @db.VarChar(36)
  userId    String?  @map("user_id") @db.VarChar(36)
  action    String   @db.VarChar(50)
  entity    String   @db.VarChar(100)
  entityId  String?  @map("entity_id") @db.VarChar(36)
  oldValue  String?  @map("old_value") @db.Text
  newValue  String?  @map("new_value") @db.Text
  ipAddress String?  @map("ip_address") @db.VarChar(50)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Company settings (key-value)
model CompanySetting {
  id        String   @id @default(uuid()) @db.VarChar(36)
  companyId String   @map("company_id") @db.VarChar(36)
  key       String   @db.VarChar(100)
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
  @@map("company_settings")
}

/// Group settings (key-value)
model GroupSetting {
  id        String   @id @default(uuid()) @db.VarChar(36)
  groupId   String   @map("group_id") @db.VarChar(36)
  key       String   @db.VarChar(100)
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  group CompanyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, key])
  @@map("group_settings")
}

/// Group-wide policies
model GroupPolicy {
  id        String   @id @default(uuid()) @db.VarChar(36)
  groupId   String   @map("group_id") @db.VarChar(36)
  name      String   @db.VarChar(255)
  code      String   @unique @db.VarChar(50)
  type      String   @db.VarChar(50)
  content   String?  @db.Text
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  group CompanyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([code])
  @@map("group_policies")
}

// ============================================================
// ENUMS
// ============================================================

enum Status {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  LOCKED
}

enum EmploymentStatus {
  ACTIVE
  RESIGNED
  TERMINATED
  PROBATION
  CONTRACT_END
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  INTERN
  PROBATION
  FREELANCE
  OUTSOURCING
}

enum LoginStatus {
  SUCCESS
  FAILED
  LOCKED
  EXPIRED
}

enum RoleScope {
  GLOBAL
  GROUP
  COMPANY
}
