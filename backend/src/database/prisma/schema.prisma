  publishedById         String?                 @map("published_by_id") @db.VarChar(36)
  finalApprovedById     String?                 @map("final_approved_by_id") @db.VarChar(36)
  reopenedById          String?                 @map("reopened_by_id") @db.VarChar(36)
  disputeDeadline       DateTime?               @map("dispute_deadline")
  acknowledgedAt        DateTime?               @map("acknowledged_at")
  acknowledgementNote   String?                 @map("acknowledgement_note") @db.Text
  finalApprovedAt       DateTime?               @map("final_approved_at")
  finalApprovalNote     String?                 @map("final_approval_note") @db.Text
  reopenedAt            DateTime?               @map("reopened_at")
  reopenReason          String?                 @map("reopen_reason") @db.Text
  reopenCount           Int                     @default(0) @map("reopen_count")
  lastReminderAt        DateTime?               @map("last_reminder_at")
  reminderCount         Int                     @default(0) @map("reminder_count")
  calculatedAt          DateTime?               @map("calculated_at")
  calibratedAt          DateTime?               @map("calibrated_at")
  finalizedAt           DateTime?               @map("finalized_at")
  publishedAt           DateTime?               @map("published_at")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")

  company                    Company                                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  period                     PerformancePeriod                      @relation(fields: [periodId], references: [id], onDelete: Cascade)
  assignment                 PerformancePlanningAssignment          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  method                     PerformanceMethod                      @relation(fields: [methodId], references: [id], onDelete: Restrict)
  methodVersion              PerformanceMethodVersion               @relation(fields: [methodVersionId], references: [id], onDelete: Restrict)
  employee                   Employee                               @relation("PerformanceResultEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  reviewer                   Employee?                              @relation("PerformanceResultReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  approver                   Employee?                              @relation("PerformanceResultApprover", fields: [approverId], references: [id], onDelete: SetNull)
  overriddenBy               Employee?                              @relation("PerformanceResultOverrideActor", fields: [overriddenById], references: [id], onDelete: SetNull)
  publishedBy                Employee?                              @relation("PerformanceResultPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  finalApprovedBy            Employee?                              @relation("PerformanceResultFinalApprover", fields: [finalApprovedById], references: [id], onDelete: SetNull)
  reopenedBy                 Employee?                              @relation("PerformanceResultReopenActor", fields: [reopenedById], references: [id], onDelete: SetNull)
  calibrationParticipants    PerformanceCalibrationParticipant[]
