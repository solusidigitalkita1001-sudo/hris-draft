/// Daily attendance record
model Attendance {
  id                 String                   @id @default(uuid()) @db.VarChar(36)
  employeeId         String                   @map("employee_id") @db.VarChar(36)
  companyId          String                   @map("company_id") @db.VarChar(36)
  branchId           String?                  @map("branch_id") @db.VarChar(36)
  attendancePolicyId String?                  @map("attendance_policy_id") @db.VarChar(36)
  resolvedCalendarId String?                  @map("resolved_calendar_id") @db.VarChar(36)
  date               DateTime                 @map("date") @db.Date
  checkIn            DateTime?                @map("check_in")
  checkOut           DateTime?                @map("check_out")
  method             AttendanceCaptureMethod  @default(MANUAL)
  source             String?                  @db.VarChar(50)
  checkInLatitude    Float?                   @map("check_in_latitude")
  checkInLongitude   Float?                   @map("check_in_longitude")
  checkOutLatitude   Float?                   @map("check_out_latitude")
  checkOutLongitude  Float?                   @map("check_out_longitude")
  distanceMeters     Int?                     @map("distance_meters")
  isWithinRadius     Boolean?                 @map("is_within_radius")
  status             AttendanceStatus         @default(PRESENT)
  workDuration       Int?                     @default(0) @map("work_duration")
  lateMinutes        Int?                     @default(0) @map("late_minutes")
  earlyLeaveMinutes  Int?                     @default(0) @map("early_leave_minutes")
  scheduledWorkStart String?                  @map("scheduled_work_start") @db.VarChar(5)
  scheduledWorkEnd   String?                  @map("scheduled_work_end") @db.VarChar(5)
  isException        Boolean                  @default(false) @map("is_exception")
  exceptionType      AttendanceExceptionType? @map("exception_type")
  exceptionReason    String?                  @map("exception_reason") @db.Text
  requiresReview     Boolean                  @default(false) @map("requires_review")
  policySnapshot     Json?                    @map("policy_snapshot")
  notes              String?                  @db.Text
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  deletedAt          DateTime?                @map("deleted_at")

  employee         Employee                @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  company          Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch           Branch?                 @relation(fields: [branchId], references: [id], onDelete: SetNull)
  attendancePolicy BranchAttendancePolicy? @relation(fields: [attendancePolicyId], references: [id], onDelete: SetNull)
  faceLogs         AttendanceFaceLog[]

  @@unique([employeeId, date])
  @@index([companyId])
  @@index([branchId])
  @@index([attendancePolicyId])
  @@index([date])
  @@index([employeeId])
  @@index([status])
  @@index([method])
  @@index([requiresReview])
  corrections AttendanceCorrection[]

  @@map("attendances")
}

model AttendanceCorrection {
  id                String                     @id @default(uuid()) @db.VarChar(36)
  employeeId        String                     @map("employee_id") @db.VarChar(36)
  companyId         String                     @map("company_id") @db.VarChar(36)
  attendanceId      String?                    @map("attendance_id") @db.VarChar(36)
  date              DateTime                   @map("date") @db.Date
  requestedCheckIn  DateTime?                  @map("requested_check_in")
  requestedCheckOut DateTime?                  @map("requested_check_out")
  reason            String                     @db.Text
  status            AttendanceCorrectionStatus @default(PENDING)
  approvedBy        String?                    @map("approved_by") @db.VarChar(36)
  approvedAt        DateTime?                  @map("approved_at")
  rejectionReason   String?                    @map("rejection_reason") @db.Text
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")
  deletedAt         DateTime?                  @map("deleted_at")

  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  attendance Attendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([employeeId])
  @@index([status])
  @@index([date])
  @@map("attendance_corrections")
}

model BranchAttendancePolicy {
  id                            String                 @id @default(uuid()) @db.VarChar(36)
  companyId                     String                 @map("company_id") @db.VarChar(36)
  branchId                      String?                @map("branch_id") @db.VarChar(36)
  attendanceMethod              AttendancePolicyMethod @default(MANUAL) @map("attendance_method")
  gpsLatitude                   Float?                 @map("gps_latitude")
  gpsLongitude                  Float?                 @map("gps_longitude")
  gpsRadiusMeters               Int?                   @map("gps_radius_meters")
  allowOutsideRadius            Boolean                @default(false) @map("allow_outside_radius")
  outsideRadiusAction           OutsideRadiusAction    @default(REVIEW) @map("outside_radius_action")
  lateToleranceMinutes          Int                    @default(0) @map("late_tolerance_minutes")
  earlyCheckoutToleranceMinutes Int                    @default(0) @map("early_checkout_tolerance_minutes")
  allowHolidayAttendance        Boolean                @default(false) @map("allow_holiday_attendance")
  allowWeekendAttendance        Boolean                @default(false) @map("allow_weekend_attendance")
  autoAbsentEnabled             Boolean                @default(false) @map("auto_absent_enabled")
  autoCheckoutEnabled           Boolean                @default(false) @map("auto_checkout_enabled")
  requiresSelfie                Boolean                @default(false) @map("requires_selfie")
  requiresLocation              Boolean                @default(false) @map("requires_location")
  isActive                      Boolean                @default(true) @map("is_active")
  notes                         String?                @db.Text
  createdAt                     DateTime               @default(now()) @map("created_at")
  updatedAt                     DateTime               @updatedAt @map("updated_at")
  deletedAt                     DateTime?              @map("deleted_at")

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch      Branch?      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  attendances Attendance[]

  @@unique([companyId, branchId])
  @@index([companyId])
  @@index([branchId])
  @@index([attendanceMethod])
  @@index([isActive])
  @@map("branch_attendance_policies")
}

/// Attendance face recognition audit log (B.7 Face Recognition Backend Ready).
/// Setiap clock-in selfie -> 1 row AttendanceFaceLog: similarity score vs reference, liveness verdict, mock location verdict.
/// Digunakan untuk audit "apakah karyawan ini benar-benar di kantor dengan wajahnya sendiri?".
model AttendanceFaceLog {
  id                  String               @id @default(uuid()) @db.VarChar(36)
  attendanceId        String?              @map("attendance_id") @db.VarChar(36)
  employeeId          String               @map("employee_id") @db.VarChar(36)
  companyId           String               @map("company_id") @db.VarChar(36)
  selfieUrl           String?              @map("selfie_url") @db.VarChar(500)
  /// Hasil cosine similarity vs reference photo (nilai -1.0 → 1.0; semakin dekat 1.0 semakin mirip). Threshold default 0.60.
  similarityScore     Decimal              @map("similarity_score") @db.Decimal(5, 4)
  isFaceMatch         Boolean              @default(false) @map("is_face_match")
  /// B.8 Liveness verdict dari heuristic EXIF + metadata (bukan ML deep-learning, tapi cukup deteksi foto galeri vs kamera langsung).
  livenessVerdict     LivenessVerdict      @default(NO_DATA) @map("liveness_verdict")
  /// B.9 GPS/Mock Location verdict.
  mockVerdict         MockLocationVerdict  @default(LIKELY_REAL) @map("mock_verdict")
  notes               String?              @db.Text
  createdAt           DateTime             @default(now()) @map("created_at")

  attendance Attendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  employee   Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company    Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([attendanceId])
  @@index([employeeId])
  @@index([companyId])
  @@index([isFaceMatch])
  @@map("attendance_face_logs")
}

/// Server-owned biometric template. The encrypted embedding is never exposed
/// through the normal Employee API and the source photo is not retained.
model EmployeeFaceProfile {
  id                   String   @id @default(uuid()) @db.VarChar(36)
  employeeId           String   @unique @map("employee_id") @db.VarChar(36)
  companyId            String   @map("company_id") @db.VarChar(36)
  encryptedEmbedding   String   @map("encrypted_embedding") @db.LongText
  modelVersion         String   @map("model_version") @db.VarChar(100)
  embeddingDimensions  Int      @map("embedding_dimensions")
  enrollmentConfidence Float    @map("enrollment_confidence")
  enrolledAt           DateTime @default(now()) @map("enrolled_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@map("employee_face_profiles")
}

/// Overtime request
model OvertimeRequest {
  id            String         @id @default(uuid()) @db.VarChar(36)
