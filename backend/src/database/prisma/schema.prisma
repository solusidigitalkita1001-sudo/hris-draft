  id             String               @id @default(uuid()) @db.VarChar(36)
  companyId      String               @map("company_id") @db.VarChar(36)
  category       ExpenseCategory
  periodType     ClaimPeriodType      @default(MONTHLY) @map("period_type")
  limitAmount    Decimal              @map("limit_amount") @db.Decimal(15, 2)
  /// NULL / 0 = UNLIMITED (fallback no limit)
  violationAction LimitViolationAction @default(WARN) @map("violation_action")
  description    String?              @db.Text
  isActive       Boolean              @default(true) @map("is_active")
  validFrom      DateTime?            @map("valid_from")
