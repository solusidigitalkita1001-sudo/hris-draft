  groupId             String?  @map("group_id") @db.VarChar(36)
  name                String   @db.VarChar(100)
  depreciationMethod  String   @default("STRAIGHT_LINE") @map("depreciation_method") @db.VarChar(50)
  usefulLifeMonths    Int?     @map("useful_life_months")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  group CompanyGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([groupId])
  @@map("asset_categories")
}

/// Company asset
model Asset {
  id              String   @id @default(uuid()) @db.VarChar(36)
  companyId       String   @map("company_id") @db.VarChar(36)
  categoryId      String?  @map("category_id") @db.VarChar(36)
  assetCode       String   @unique @map("asset_code") @db.VarChar(50)
  name            String   @db.VarChar(150)
  serialNumber    String?  @map("serial_number") @db.VarChar(100)
  purchaseDate    DateTime? @map("purchase_date")
  purchaseValue   Decimal? @map("purchase_value") @db.Decimal(15, 2)
  currentValue    Decimal? @map("current_value") @db.Decimal(15, 2)
  status          String   @default("AVAILABLE") @db.VarChar(20)
  branchId        String?  @map("branch_id") @db.VarChar(36)
  notes           String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assignments AssetAssignment[]

  @@index([companyId])
  @@index([assetCode])
  @@index([status])
  @@map("assets")
}

/// Asset assignment to employee
model AssetAssignment {
  id                  String   @id @default(uuid()) @db.VarChar(36)
  assetId             String   @map("asset_id") @db.VarChar(36)
  employeeId          String   @map("employee_id") @db.VarChar(36)
  assignedAt          DateTime @default(now()) @map("assigned_at")
  conditionAtAssign   String   @default("GOOD") @map("condition_at_assign") @db.VarChar(20)
  returnedAt          DateTime? @map("returned_at")
  conditionAtReturn   String?  @map("condition_at_return") @db.VarChar(20)
  notes               String?  @db.Text
  createdBy           String   @map("created_by") @db.VarChar(36)
  createdAt           DateTime @default(now()) @map("created_at")

  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([assetId])
  @@index([employeeId])
  @@index([returnedAt])
  @@map("asset_assignments")
}

