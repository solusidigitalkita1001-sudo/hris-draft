  content          String               @db.Text
  coverImageUrl    String?              @map("cover_image_url") @db.VarChar(500)
  priority         AnnouncementPriority @default(NORMAL)
  status           AnnouncementStatus   @default(DRAFT)
  publishFrom      DateTime?            @map("publish_from") /// null = langsung terbit jika status=PUBLISHED
  publishUntil     DateTime?            @map("publish_until") /// null = tidak expired
  pinnedUntil      DateTime?            @map("pinned_until") /// PINNED memiliki masa aktif
