# Fixture acceptance mobile (BE-02 / BE-05).
#
# Salin ke .env.mobile-fixture di SERVER, isi nilainya, lalu:
#
#   set -a; . ./.env.mobile-fixture; set +a
#   npm --prefix backend run fixtures:mobile          # dry run: cetak rencana, tidak menulis
#   MOBILE_FIXTURE_APPLY=staging-synthetic-only \
#     npm --prefix backend run fixtures:mobile        # baru menulis
#
# Jangan commit file terisinya. Data uji harus sintetis — jangan memakai
# selfie, NIK, atau koordinat rumah karyawan sungguhan.

# Karyawan yang dipakai tim mobile untuk uji absensi/ESS. Harus sudah ada.
MOBILE_FIXTURE_EMPLOYEE_EMAIL=

# Pagar keselamatan: skrip berhenti kalau karyawan itu ternyata bukan milik
# company/branch ini. Isi dengan UUID yang kamu harapkan.
MOBILE_FIXTURE_EXPECT_COMPANY_ID=
MOBILE_FIXTURE_EXPECT_BRANCH_ID=

# Tahun kalender kerja yang disiapkan (default: tahun berjalan).
MOBILE_FIXTURE_YEAR=2026

# Geofence kantor. Radius dalam meter — pakai 150–300 untuk kantor biasa.
MOBILE_FIXTURE_CONFIGURE_GPS=true
MOBILE_FIXTURE_GPS_LATITUDE=
MOBILE_FIXTURE_GPS_LONGITUDE=
MOBILE_FIXTURE_GPS_RADIUS_METERS=200

# Wajibkan selfie saat check-in, dan daftarkan wajahnya dari satu foto.
# Path foto dibaca DI SERVER, bukan di laptop.
MOBILE_FIXTURE_REQUIRE_SELFIE=true
MOBILE_FIXTURE_FACE_IMAGE_PATH=

# Hanya nyalakan kalau kamu sadar konsekuensinya.
# ALLOW_SHARED_BRANCH: izinkan memakai branch yang juga dipakai karyawan lain.
# ALLOW_PRODUCTION: izinkan dijalankan di database production.
MOBILE_FIXTURE_ALLOW_SHARED_BRANCH=false
MOBILE_FIXTURE_ALLOW_PRODUCTION=false
