# =====================================================
# Standard project ignores
# =====================================================
# OS junk
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# IDEs & Editor junk
.vscode/
.idea/
*.swp
*.swo
*~

# Tool specific folders
.claude/
dbg/
**/dbg/
docker/

# Package install directories
node_modules/
.pnp
.pnp.js
jspm_packages/

# Build output
dist/
build/
out/
.next/
.nuxt/
.cache/
.parcel-cache/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Env & local secrets files — NEVER push these 🔒
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.crt

# Test coverage
coverage/
*.lcov
.nyc_output/

# TypeScript build cache
*.tsbuildinfo

# Docker Compose configuration is environment-specific
docker-compose*.yml
docker-compose*.yaml
